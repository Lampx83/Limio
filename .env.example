# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://feedbackme:feedbackme@localhost:5433/feedbackme?schema=public"

# Redis — dùng cho realtime (SSE/Streams), BullMQ queue, rate limit
REDIS_URL="redis://localhost:6379"

# NextAuth (set NEXTAUTH_SECRET to a 32+ byte random string in real envs)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth (optional for Phase 0; email/password works without it)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Anthropic (Phase 2+)
ANTHROPIC_API_KEY=""

# Growth attribution (optional, off by default) — xem docs/growth-events.md
# GROWTH_ATTRIBUTION_ENABLED=true
# GROWTH_EVENTS_SECRET=   # >= 32 ký tự (openssl rand -hex 32), dùng chung với SIM
# GROWTH_ANON_SECRET=     # >= 32 ký tự, KHÔNG chia sẻ
