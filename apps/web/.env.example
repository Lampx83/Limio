# Required everywhere
DATABASE_URL=postgresql://feedbackme:feedbackme@localhost:5433/feedbackme?schema=public
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-32-byte-random-base64

# Encryption master key for IntegrationCredential (AES-256-GCM)
# Generate: openssl rand -hex 32
SECRETS_MASTER_KEY=

# AI features (admin can also configure via /admin/integrations UI)
OPENAI_API_KEY=
AI_TURNS_PER_HOUR=10
AI_TOKENS_PER_DAY=50000

# LTI 1.3 (only if accepting external LTI tools)
LTI_PLATFORM_ISSUER=http://localhost:3000

# File storage — local fs by default; set S3_* for prod
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
SCORM_STORAGE_ROOT=
H5P_STORAGE_ROOT=

# Error monitoring (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Payments (optional, only if charging for courses)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
