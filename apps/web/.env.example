# Required everywhere
DATABASE_URL=postgresql://feedbackme:feedbackme@localhost:5433/feedbackme?schema=public
NEXTAUTH_URL=http://localhost:3000

# Origin công khai dùng cho SEO (canonical, sitemap.xml, robots.txt, ảnh OG).
# Bỏ trống thì lấy NEXTAUTH_URL. Chỉ cần set khi domain người dùng thấy khác
# domain callback của auth (vd. đứng sau CDN hoặc proxy đổi host).
SITE_URL=
NEXTAUTH_SECRET=replace-with-32-byte-random-base64

# SSO (optional — only enabled if both ID + secret are set per provider)
# Google: https://console.cloud.google.com → OAuth 2.0 Client IDs
#   Authorized redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra ID: https://entra.microsoft.com → App registrations
#   Redirect URI: ${NEXTAUTH_URL}/api/auth/callback/microsoft-entra-id
#   Tenant: "common" allows any tenant + personal accounts; or your tenant GUID
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Encryption master key for IntegrationCredential (AES-256-GCM)
# Generate: openssl rand -hex 32
SECRETS_MASTER_KEY=

# AI features (admin can also configure via /admin/integrations UI)
OPENAI_API_KEY=
# Chat LLM tự host (vLLM, API tương thích OpenAI) — BẮT BUỘC cho mọi tính năng AI chat.
# Mọi lời gọi chat đi vào đây; bỏ trống LLM_BASE_URL thì chat báo chưa cấu hình (không
# rơi về OpenAI). Embeddings/Whisper/TTS vẫn là OpenAI (cần OPENAI_API_KEY).
# LLM_CHAT_MODEL bỏ trống = qwen3.5-35b-a3b-int4.
LLM_BASE_URL=
LLM_CHAT_MODEL=
LLM_SECKEY=
AI_TURNS_PER_HOUR=10
AI_TOKENS_PER_DAY=50000

# LTI 1.3 (only if accepting external LTI tools)
LTI_PLATFORM_ISSUER=http://localhost:3000

# File storage — local fs by default; set S3_* for prod
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
SCORM_STORAGE_ROOT=
H5P_STORAGE_ROOT=

# Error monitoring (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Payments (optional, only if charging for courses)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email — chọn 1: SMTP (SMTP_HOST) hoặc Resend (RESEND_API_KEY). Không đặt → chỉ log ra console.
# EMAIL_FROM="Limio <no-reply@limio.vn>"
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# RESEND_API_KEY=

# Google Analytics 4 (optional) — Measurement ID dạng G-XXXXXXXXXX, lấy từ
# admin.google.com/analytics sau khi tạo property. Bỏ trống → không load GA.
# ID = property riêng của domain đang deploy (limio.vn / limio.hust.edu.vn có
# ID khác nhau). _ALL = property tổng gộp, đặt CÙNG giá trị trên mọi server.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID_ALL=
