# Required everywhere
DATABASE_URL=postgresql://feedbackme:feedbackme@localhost:5433/feedbackme?schema=public
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-32-byte-random-base64

# SSO (optional — only enabled if both ID + secret are set per provider)
# Google: https://console.cloud.google.com → OAuth 2.0 Client IDs
#   Authorized redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra ID: https://entra.microsoft.com → App registrations
#   Redirect URI: ${NEXTAUTH_URL}/api/auth/callback/microsoft-entra-id
#   Tenant: "common" allows any tenant + personal accounts; or your tenant GUID
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Encryption master key for IntegrationCredential (AES-256-GCM)
# Generate: openssl rand -hex 32
SECRETS_MASTER_KEY=

# AI features (admin can also configure via /admin/integrations UI)
OPENAI_API_KEY=
AI_TURNS_PER_HOUR=10
AI_TOKENS_PER_DAY=50000

# LTI 1.3 (only if accepting external LTI tools)
LTI_PLATFORM_ISSUER=http://localhost:3000

# File storage — local fs by default; set S3_* for prod
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
SCORM_STORAGE_ROOT=
H5P_STORAGE_ROOT=

# Error monitoring (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Payments (optional, only if charging for courses)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
