# FeedBackMe scheduled jobs (replaces Vercel cron from apps/web/vercel.json)
# Endpoints authenticate via Bearer ${CRON_SECRET}.
0 0 * * *    /usr/local/bin/run.sh streak-grace-check
# Ranking board — endpoint internally detects which periods just closed at VN midnight (daily always; weekly on Mon; monthly on day 1). Runs 5 min after streak job to spread DB load at 00:00 VN.
5 0 * * *    /usr/local/bin/run.sh leaderboard-close
*/5 * * * *  /usr/local/bin/run.sh tournament-tick
*    * * * *  /usr/local/bin/run.sh exam-autosubmit
# Recovery: re-grade ExamAttempts kẹt ở submitted/auto_submitted với score=NULL
# (do BullMQ worker chết hoặc Redis đứt lúc submit nên auto-grade job không
# chạy được). Grace 1 phút trước khi pick up — cho worker cơ hội xử lý trước.
*    * * * *  /usr/local/bin/run.sh exam-stuck-grade
# A5.3.6 — Heartbeat-lost detector. Cheap query on (status, lastHeartbeatAt)
# index; in-memory dedups so re-runs don't spam dashboard with the same row.
*/2  * * * *  /usr/local/bin/run.sh exam-heartbeat-watch
# A5.4 — Nightly item-analytics rebuild. UPSERT per ExamQuestionStats /
# BankQuestionStats row. Idempotent; target runtime ≤ 30s.
0 2  * * *  /usr/local/bin/run.sh exam-analytics
