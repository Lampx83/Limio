# GlitchTip trên server 224 — copy sang /etc/glitchtip/.env (chmod 600).
# KHÔNG commit file .env thật.

# Tên miền công khai (không có https://). Cần bản ghi DNS trỏ về server 224 và
# reverse proxy ngoài host chuyển về 127.0.0.1:${GLITCHTIP_PORT}.
GLITCHTIP_HOSTNAME=glitchtip.limio.vn

# Sinh: openssl rand -hex 32
GLITCHTIP_SECRET_KEY=
# Sinh: openssl rand -hex 24
GLITCHTIP_POSTGRES_PASSWORD=

# Cổng trên host (chỉ bind 127.0.0.1). Đổi nếu 8010 đã có service khác dùng.
GLITCHTIP_PORT=8010

# Số ngày giữ lỗi.
GLITCHTIP_RETENTION_DAYS=30

# Gửi email cảnh báo (tuỳ chọn). Định dạng django-environ, ví dụ:
#   smtp+tls://user:password@smtp.example.com:587
# Bỏ trống = email chỉ in ra log; vẫn dùng được cảnh báo qua webhook.
GLITCHTIP_EMAIL_URL=
GLITCHTIP_FROM_EMAIL=glitchtip@limio.vn
