# Tintin — internal LB cho web replicas. Docker DNS resolve `web` thành
# danh sách IP của tất cả replica → Caddy round-robin giữa chúng.
# Sticky session KHÔNG cần (NextAuth JWT stateless + exam-live-bus đã Redis-backed
# sau Tintin #1) nên policy round_robin OK cho mọi request.

{
	# Caddy admin API (chỉ trong container — không expose host)
	admin off
	# Không tự lấy TLS — TLS termination do reverse proxy ngoài host xử lý.
	auto_https off

	# IP thật của người dùng. Proxy ngoài host (nginx) nằm trong dải riêng nên được
	# tin; Caddy lấy IP cuối cùng KHÔNG thuộc dải tin cậy trong X-Forwarded-For của
	# nó. Không cấu hình bước này thì {remote_host} luôn là IP của chính proxy ngoài,
	# và ứng dụng không bao giờ thấy IP người dùng (giới hạn mạng vào thi theo
	# trường dựa vào đây). Nếu proxy ngoài không gửi X-Forwarded-For thì {client_ip}
	# rơi về địa chỉ kết nối — y như hành vi cũ, không tệ hơn.
	#
	# trusted_proxies_strict BẮT BUỘC: không có nó Caddy lấy IP ĐẦU chuỗi, mà đó là
	# thứ người dùng tự gửi lên (nginx chỉ nối IP thật vào cuối) — ai cũng giả được IP
	# mạng trường. Strict thì đọc từ phải sang trái, bỏ qua proxy tin cậy.
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

:80 {
	encode gzip

	# Health endpoint — external proxy/healthcheck dùng để biết LB đang sống
	# (không cần touch web).
	respond /caddy-healthz 200

	reverse_proxy web:3000 {
		lb_policy round_robin
		# DNS re-resolve mỗi 10s để khi replicas thêm/giảm Caddy biết ngay.
		# Caddy 2 dùng dynamic upstream qua plugin; với DNS A-record nhiều IP
		# trên Docker network, round_robin sẽ auto rotate.
		fail_duration 10s
		max_fails 2
		# SSE / long-poll: tắt buffering response (Caddy mặc định stream OK,
		# nhưng để chắc).
		flush_interval -1

		# Tintin: pool keepalive cho 5K SV đồng thời.
		# Mặc định Caddy giữ ~32 idle/host → nghẽn khi 5K heartbeat đập vào 3 web replicas.
		# 2000 total / 500 per-host cho phép tái dùng kết nối TCP tới upstream,
		# tránh phải bắt tay TCP+HTTP cho mỗi request trong burst.
		transport http {
			keepalive 5m
			keepalive_idle_conns 2000
			keepalive_idle_conns_per_host 500
			dial_timeout 5s
			# SSE dashboard có thể giữ tới ~60s không có header reply mới;
			# nâng lên 5m để không cắt nhầm long-poll/SSE upstream chậm.
			response_header_timeout 5m
		}

		# Truyền X-Forwarded-* để Next.js NextAuth/rate-limit thấy IP gốc.
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}
