{
  "name": "@feedbackme/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node --env-file=.env --import tsx src/seed.ts",
    "seed:sample-course": "node --env-file=.env --import tsx src/seed-sample-course.ts",
    "seed:demo-users": "node --env-file=.env --import tsx src/seed-demo-users.ts",
    "seed:demo-gamification": "node --env-file=.env --import tsx src/seed-demo-gamification.ts",
    "seed:badges": "node --env-file=.env --import tsx src/seed-badges.ts",
    "seed:feedback-templates": "node --env-file=.env --import tsx src/seed-feedback-templates.ts",
    "seed:quests": "node --env-file=.env --import tsx src/seed-quests.ts",
    "seed:mission-templates": "node --env-file=.env --import tsx src/seed-mission-templates.ts",
    "seed:email-templates": "node --env-file=.env --import tsx src/seed-email-templates.ts",
    "seed:demo-english-center": "node --env-file=.env --import tsx src/seed-demo-english-center.ts",
    "seed:limio-live-demo": "node --env-file=.env --import tsx src/seed-limio-live-demo.ts",
    "seed:feature-flags": "node --env-file=.env --import tsx src/seed-feature-flags.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@feedbackme/shared-types": "workspace:*",
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^2.4.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
