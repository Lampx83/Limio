// FeedBackMe — Phase 0 schema
// Source of truth: docs/SPEC.docx §3 (Module A), §6.1 (events), §7 (data model).
// Scope of this file: tables required to deliver Phase 0 features
// A1 (Auth), A2 (Course mgmt), A3 (Course player), A4 (Quiz),
// plus Bridge (Skill graph + LearningEvent).
// Other modules (Feedback Engine, Gamification, Tournament) added in later phases.

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, vector]
}

// =====================================================================
// A1 — Authentication & User Management
// =====================================================================

model User {
  id                          String    @id @default(uuid())
  email                       String    @unique
  emailVerifiedAt             DateTime?
  passwordHash                String?
  displayName                 String
  avatarUrl                   String?
  // PR2.17 — Multi-tenancy: user thuộc về 1 Organization. Nullable trong
  // backfill phase; sẽ siết NOT NULL ở migration tiếp theo.
  organizationId              String?
  locale                      String    @default("vi")
  timezone                    String    @default("Asia/Ho_Chi_Minh")
  // Phase 1 C5: when true, user's XP transactions are excluded from public
  // leaderboards. Per spec §5.5 "opt-out leaderboard hoàn toàn được".
  leaderboardOptOut           Boolean   @default(false)
  // A5.5 — Cơ bản/Nâng cao mode toggle. False = ẩn IRT/anchor/equating metrics,
  // chỉ hiện badge ⭐ và mức tư duy 3 nhóm. True = mở khoá full psychometrics.
  expertAssessmentMode        Boolean   @default(false)
  // A5.5 — Counter exam đã tạo. Tăng atomic khi exam publish. Dùng để trigger
  // banner gợi ý "Bật chế độ Nâng cao?" khi >= 3 và expertAssessmentMode=false.
  examsCreatedCount           Int       @default(0)
  // Last time user opened the notification bell — drives unread-count.
  // notificationsLastSeenAt: legacy global value; new code uses the JSON map
  // below so each role tracks its own seen-state independently.
  notificationsLastSeenAt     DateTime?
  notificationsLastSeenByRole Json?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  authProviders            AuthProvider[]
  userRoles                UserRole[]
  enrollments              Enrollment[]
  authoredCourses          CourseInstructor[]
  quizAttempts             QuizAttempt[]
  learningEvents           LearningEvent[]
  lessonEngagements        LessonEngagement[]
  verificationTokens       VerificationToken[]
  notes                    Note[]
  courseProgress           UserCourseProgress[]
  xpTransactions           XpTransaction[]
  userBadges               UserBadge[]
  streakRecords            StreakRecord[]
  skillStates              LearnerSkillState[]
  misconceptionFlags       MisconceptionFlag[]
  feedbackDeliveries       FeedbackDelivery[]
  assignmentSubmissions    AssignmentSubmission[]    @relation("Submitter")
  gradedSubmissions        AssignmentSubmission[]    @relation("Grader")
  forumThreads             ForumThread[]
  forumPosts               ForumPost[]
  questProgress            UserQuestProgress[]
  tournamentRegistrations  TournamentRegistration[]
  tournamentCreated        Tournament[]              @relation("TournamentCreator")
  tournamentTeamsCaptained TournamentTeam[]          @relation("TeamCaptain")
  hackathonVotes           HackathonVote[]           @relation("HackathonVoter")
  tournamentJudgeOf        TournamentJudge[]         @relation("TournamentJudge")
  missionSubmissions       MissionSubmission[]
  missionReviews           MissionReviewAssignment[]
  scormAttempts            ScormAttempt[]
  scormPackagesUploaded    ScormPackage[]            @relation("ScormUploader")
  ltiToolsRegistered       LtiTool[]                 @relation("LtiToolRegistrar")
  ltiLaunches              LtiLaunch[]
  h5pPackagesUploaded      H5pPackage[]              @relation("H5pUploader")
  h5pAttempts              H5pAttempt[]
  aiConversations          AiConversation[]
  aiUsageLogs              AiUsageLog[]
  aiTokenLedger            AiTokenLedger[]
  aiTokenBalance           AiTokenBalance?
  createdAccessCodes       CourseAccessCode[]        @relation("CourseAccessCodeCreator")
  redeemedAccessCodes      CourseAccessCode[]        @relation("CourseAccessCodeRedeemer")
  orders                   Order[]
  auditEntriesAsActor      AuditLog[]                @relation("AuditActor")
  auditEntriesAsTarget     AuditLog[]                @relation("AuditTarget")

  // A7 Exam
  examAttempts             ExamAttempt[]
  examAssetsUploaded       ExamAsset[]              @relation("ExamAssetUploader")
  // A6.1 — Vấn đáp AI: tài liệu GV upload cho giảng viên ảo.
  oralExamMaterialsUploaded OralExamMaterial[]      @relation("OralExamMaterialUploader")
  // A6.4 — GV duyệt/sửa điểm AI đề xuất cho buổi vấn đáp.
  oralExamEvaluationsGraded OralExamEvaluation[]    @relation("OralExamEvaluationGrader")
  examAnswersGraded        ExamAnswer[]             @relation("ExamGrader")
  examGradeChanges         ExamGradeHistory[]       @relation("ExamGradeChanger")
  // A5.3.5 — Instructor → student messages during live exam.
  examMessagesSent         ExamMessage[]            @relation("ExamMessageSender")
  // A7.7.5 — Instructors mark proctor snapshots they've reviewed.
  proctorSnapshotsReviewed AttemptProctorSnapshot[] @relation("ProctorSnapshotReviewer")
  // P0 phòng thi — rooms this user is assigned to as proctor / grader.
  examRoomsAsProctor       ExamRoom[]               @relation("ExamRoomProctor")
  examRoomsAsGrader        ExamRoomGrader[]         @relation("ExamRoomGrader")
  // A5.3 Đợt thi — round-level admin (trưởng đợt thi).
  examRoundsAsAdmin        ExamRoundAdmin[]
  // A5.3 Thí sinh có thể link tới User account (nullable — candidate có thể chưa có account).
  examCandidateLinks       ExamCandidate[]          @relation("ExamCandidateUser")
  examRoundAdminGrants     ExamRoundAdmin[]         @relation("ExamRoundAdminGrantor")
  // A5.1 Question Bank
  questionBanksOwned       QuestionBank[]           @relation("QuestionBankOwner")
  bankQuestionsReviewed    BankQuestion[]           @relation("BankQuestionReviewedBy")
  // A5.5 — Exam tạo bởi user này (set khi publish; nullable cho exam legacy).
  examsCreated             Exam[]                   @relation("ExamCreator")
  // A5.2 Cohort (renamed to CourseSection — see model comment)
  cohortMemberships        CohortMember[]
  sectionsAsInstructor     CourseSection[]          @relation("CohortInstructor")

  // PR2.17 — Multi-tenancy
  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  orgAdminOf   OrganizationAdmin[]

  // Classroom tools
  classroomRandomPicks ClassroomRandomPick[]
  classroomPollVotes   ClassroomPollVote[]
  createdPolls         ClassroomPoll[]       @relation("PollCreator")
  createdWordClouds    WordCloud[]           @relation("WordCloudCreator")
  wordCloudSubmissions WordCloudSubmission[]
  ownedBoards          InteractiveBoard[]    @relation("BoardOwner")
  boardNotes           BoardNote[]
  ownedWhiteboards     Whiteboard[]          @relation("WhiteboardOwner")
  groupMemberships     GroupMembership[]
  timerTemplates       TimerTemplate[]
  teachingActivityPlans TeachingActivityPlan[]
  teachingActivityPlanCollaborations TeachingActivityPlanCollaborator[]
  teachingActivityPlanSaves          TeachingActivityPlanSave[]
  teachingActivityPlanLikes          TeachingActivityPlanLike[]
  liveDecks            LiveDeck[]
  liveDeckGroups       LiveDeckGroup[]
  liveSessionsHosted   LiveSession[]

  // Gameshow
  gameSessionsHosted GameSession[]     @relation("GameSessionHost")
  gameParticipations GameParticipant[]
  gameQuestionSets   GameQuestionSet[]

  leaderboardEntries LeaderboardEntry[]

  // Admin email templates — last editor + revision history
  emailTemplatesUpdated  EmailTemplate[]         @relation("EmailTemplateEditor")
  emailTemplateRevisions EmailTemplateRevision[] @relation("EmailTemplateReviser")
  // Email dispatch batches this user created / approved
  emailBatchesCreated    EmailDispatchBatch[]    @relation("EmailBatchCreator")
  emailBatchesApproved   EmailDispatchBatch[]    @relation("EmailBatchApprover")
  aiTokenOrders          AiTokenOrder[]
  featureOverrides       UserFeatureOverride[]

  @@index([createdAt])
}

model AuthProvider {
  id             String   @id @default(uuid())
  userId         String
  provider       String // "password" | "google"
  providerUserId String // email for password, sub for google
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Role {
  id              String                @id @default(uuid())
  name            String                @unique // "learner" | "instructor" | "admin" | "mentor"
  description     String?
  userRoles       UserRole[]
  featureOverrides RoleFeatureOverride[]
}

// Role can be scoped per-course (A1 acceptance: "1 user là learner ở course A,
// instructor ở course B"). courseId NULL = platform-wide role.
model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  courseId  String?
  grantedAt DateTime @default(now())
  grantedBy String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id])
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, courseId])
  @@index([userId])
  @@index([courseId])
}

enum TokenPurpose {
  email_verify
  password_reset
}

// Single-use tokens for email verification and password reset.
// We store SHA-256 of the raw token, never the raw token itself —
// defense in depth if DB leaks.
model VerificationToken {
  id         String       @id @default(uuid())
  userId     String
  purpose    TokenPurpose
  tokenHash  String       @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// A1 acceptance: "Audit log mọi thay đổi role".
// Generic audit table — not just for roles, but role changes are the
// minimum required for Phase 0.
model AuditLog {
  id           String   @id @default(uuid())
  action       String // e.g. "role.granted", "role.revoked", "user.email_changed"
  actorUserId  String?
  targetUserId String?
  payload      Json // before/after, plus action-specific fields
  occurredAt   DateTime @default(now())

  actor  User? @relation("AuditActor", fields: [actorUserId], references: [id])
  target User? @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@index([action, occurredAt])
  @@index([targetUserId, occurredAt])
}

// =====================================================================
// D1 — Feature permission (cross-cutting Integration layer, không thuộc
// riêng module A/B/C nào). Bổ sung cho RBAC (Role/UserRole) sẵn có: role trả
// lời "user này LÀ ai" (ranh giới chức năng), còn catalog này trả lời "user
// này ĐƯỢC BẬT tính năng gì" (ranh giới governance/thương mại) — 2 trục độc
// lập, cùng tồn tại song song với UserRole chứ không thay thế.
//
// Resolution: UserFeatureOverride > RoleFeatureOverride > FeatureFlag.default.
// Đa role xung đột: OR cho boolean, MAX cho int (role nào cho phép nhiều
// hơn thì thắng — nhất quán với isInstructor()-style check hiện có coi user
// có bất kỳ scope nào của role đó là đủ).
// =====================================================================

enum FeatureGroup {
  teaching_tools
  lms
  assessment
  ai_oral
  ai_tutor
  tournament
  limio_live
}

enum FeatureValueType {
  boolean
  int
  string_array
}

model FeatureFlag {
  id           String           @id @default(uuid())
  key          String           @unique
  group        FeatureGroup
  name         String
  description  String
  valueType    FeatureValueType
  defaultValue Json
  // Chuẩn bị cho thương mại hoá (bán theo gói/tier) — key nào KHÔNG sellable
  // là gate chức năng/an toàn (vd chặn learner vào công cụ giảng dạy), không
  // nên có nút "mua để mở khoá". Chưa có Subscription/Tier ở P0 — field này
  // chỉ để catalog sẵn sàng, chưa được đọc ở đâu.
  sellable     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  roleOverrides RoleFeatureOverride[]
  userOverrides UserFeatureOverride[]

  @@index([group])
}

model RoleFeatureOverride {
  id         String   @id @default(uuid())
  roleId     String
  featureKey String
  value      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  role    Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  feature FeatureFlag @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([roleId, featureKey])
}

model UserFeatureOverride {
  id         String   @id @default(uuid())
  userId     String
  featureKey String
  value      Json
  // Bắt buộc — override cấp cho 1 user cụ thể luôn cần lý do để trace lại
  // sau này (support comp, dùng thử, xử lý sự cố...).
  reason     String
  grantedBy  String
  // null = vĩnh viễn tới khi admin thu hồi tay. Chuẩn bị cho gói bán có hạn
  // (dùng thử N ngày) — P0 chưa có UI đặt hạn, nhưng cột có sẵn để không
  // phải migration phá vỡ dữ liệu sau này.
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature FeatureFlag @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([userId, featureKey])
  @@index([userId])
  @@index([expiresAt])
}

// =====================================================================
// A2 — Course Management
// =====================================================================

enum CourseStatus {
  draft
  review
  published
  archived
}

/// B16 — cách một người vào được khoá học.
enum EnrollMode {
  /// Ai cũng tự đăng ký từ trang giới thiệu khoá (vẫn qua cổng thanh toán nếu
  /// khoá có phí).
  open
  /// Chỉ vào được bằng link mời của một lớp cụ thể. Trang giới thiệu vẫn xem
  /// được, nhưng không có nút đăng ký.
  invite_only
}

model Course {
  id                     String       @id @default(uuid())
  // PR2.17 — Multi-tenancy: course thuộc về 1 Organization. Nullable trong
  // backfill phase, sẽ siết NOT NULL sau.
  organizationId         String?
  slug                   String       @unique
  title                  String
  description            String       @db.Text
  language               String       @default("vi")
  level                  String       @default("beginner") // beginner | intermediate | advanced
  category               String?
  coverUrl               String?
  status                 CourseStatus @default(draft)
  // Course versioning (A2 acceptance: "học viên đang học bản cũ không bị break").
  // Bump this when publishing a breaking change; new enrollments take the new version.
  version                Int          @default(1)
  publishedAt            DateTime?
  // Personalization toggle: when true, course uses Feedback Engine (BKT, diagnostic,
  // adaptive path, skill badge) and publish requires every lesson to have ≥1 skill tag.
  // When false, course runs as standard LMS (no AI feedback) and publish skips the skill-tag gate.
  // Default false — see project_personalization_toggle memory.
  /// B16 — mở tự do hay chỉ vào bằng link mời lớp. Mặc định `open` để mọi khoá
  /// đang có giữ nguyên hành vi sau khi migrate.
  enrollMode             EnrollMode   @default(open)
  personalizationEnabled Boolean      @default(false)
  // Public access: when true, anyone — including logged-out visitors — may read the
  // course's lessons (content + video) without enrolling, in the same read-only
  // preview mode a non-enrolled learner gets. Account-only features (progress,
  // completion, notes, AI tutor, forum, quizzes) stay hidden.
  // Only takes effect while `status = published`; a draft course is never public.
  // Default false — existing courses keep login-gated behaviour.
  publicAccess           Boolean      @default(false)
  // Pricing — null = free; positive = paid (cents of `currency`).
  priceCents             Int?
  currency               String       @default("USD")
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  modules           Module[]
  enrollments       Enrollment[]
  instructors       CourseInstructor[]
  liveDeckGroups    LiveDeckGroup[]
  userRoles         UserRole[]
  userProgress      UserCourseProgress[]
  xpTransactions    XpTransaction[]
  streakRecords     StreakRecord[]
  tournaments       Tournament[]
  orders            Order[]
  timerTemplates    TimerTemplate[]
  exams             Exam[]
  questionBanks     QuestionBank[]
  sections          CourseSection[]
  cohortExamClasses CohortExamClass[]
  examRounds        ExamRound[]
  accessCodes       CourseAccessCode[]
  accessPlans       CourseAccessPlan[]
  organization      Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  catalogSectionCourses CatalogSectionCourse[]

  @@index([status, publishedAt])
  @@index([category, level])
}

enum CatalogSectionType {
  MANUAL
  AUTO_RECENT
}

/// A2.6 — Catalog curated sections: nhóm khoá học hiển thị trên trang public
/// `/catalog` thay vì 1 list phẳng. `/catalog` hiện tại KHÔNG lọc theo
/// Organization (1 danh sách chung toàn hệ thống) nên section cũng global,
/// quản lý bởi Platform Admin (`isAdmin`), không phải OrgAdmin.
model CatalogSection {
  id        String                 @id @default(uuid())
  title     String
  type      CatalogSectionType
  order     Int                    @default(0)
  isActive  Boolean                @default(true)
  // Chỉ dùng khi type = AUTO_RECENT: số course published gần nhất sẽ hiển thị.
  autoLimit Int?
  courses   CatalogSectionCourse[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([isActive, order])
}

/// Join table cho section type MANUAL — admin tự chọn course + thứ tự.
/// Section type AUTO_RECENT không tạo row ở đây, courses được suy ra lúc query.
model CatalogSectionCourse {
  sectionId String
  courseId  String
  order     Int            @default(0)
  section   CatalogSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([sectionId, courseId])
  @@index([courseId])
}

model CourseInstructor {
  id        String   @id @default(uuid())
  courseId  String
  userId    String
  role      String   @default("owner") // owner | co-instructor | non-editing-teacher | teaching-assistant (see core-lms/src/courses/authz.ts)
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([courseId, userId])
}

model Module {
  id         String   @id @default(uuid())
  courseId   String
  title      String
  orderIndex Int
  // Instructor-controlled visibility (false = hidden from all learners)
  isHidden   Boolean  @default(false)
  /// B14 — khoá KHÁC ẩn. Ẩn thì học viên không biết là có; khoá thì thấy tên
  /// trong mục lục kèm ổ khoá nhưng không mở được nội dung. Dùng khi muốn báo
  /// trước lộ trình mà chưa mở phần sau.
  isLocked   Boolean  @default(false)
  createdAt  DateTime @default(now())

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, orderIndex])
  @@index([courseId])
}

model Lesson {
  id                     String   @id @default(uuid())
  moduleId               String
  title                  String
  description            String?
  orderIndex             Int
  // A3 acceptance: lesson hoàn thành khi xem ≥80% video, hoặc click mark complete.
  // completionThreshold = % of video duration. NULL for non-video.
  completionThresholdPct Int?     @default(80)
  durationSec            Int?
  // True = visible to non-enrolled users as a free preview sample
  previewable            Boolean  @default(false)
  // Instructor-controlled visibility (false = hidden from all learners)
  isHidden               Boolean  @default(false)
  /// B14 — xem giải thích ở Module.isLocked. Bài nằm trong module đã khoá thì
  /// coi như khoá theo, không cần bật cờ này.
  isLocked               Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  module            Module                @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  contentItems      ContentItem[]
  quizzes           Quiz[]
  assignments       Assignment[]
  // Unified, ordered view across contentItems + quizzes + assignments.
  // Use this when rendering the lesson's activity list (instructor + learner).
  activities        LessonActivity[]
  engagements       LessonEngagement[]
  forumThreads      ForumThread[]
  aiConversations   AiConversation[]
  notes             Note[]
  skillTags         ContentSkillMapping[] @relation("LessonSkill")
  classroomSessions ClassroomSession[]

  @@unique([moduleId, orderIndex])
  @@index([moduleId])
}

enum ContentType {
  video
  markdown
  richtext
  embed
  file
  external_link
  pdf
  scorm
  lti
  h5p
  // Ghi chú của giảng viên, xen giữa nội dung bài. KHÔNG BAO GIỜ gửi cho học
  // viên: mọi truy vấn phía học viên (trang bài, trang in) lọc loại này ra ở
  // tầng truy vấn, chứ không dựa vào `isHidden` — cờ ấy do giảng viên bật tắt
  // nên có ngày quên, còn loại nội dung thì không quên được.
  teacher_note
  // GV upload 1 file .html, hiển thị trong lesson qua iframe sandbox (KHÔNG
  // allow-same-origin — script trong file không được đọc cookie/session của
  // Limio). Khác "embed" (chỉ nhận URL ngoài) và "file" (chỉ tải xuống).
  html_block
}

model ContentItem {
  id         String      @id @default(uuid())
  lessonId   String
  type       ContentType
  // type-specific payload: { url, transcriptUrl, durationSec } for video, etc.
  payload    Json
  // DEPRECATED — use LessonActivity.orderIndex. Kept for backwards-compat of any
  // legacy code path that hasn't migrated. Source of truth for display ordering
  // is now LessonActivity (cross-type ordering with Quiz + Assignment).
  orderIndex Int
  // Instructor-controlled visibility (false = hidden from all learners)
  isHidden   Boolean     @default(false)
  createdAt  DateTime    @default(now())

  lesson         Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  notes          Note[]
  lessonActivity LessonActivity?

  @@index([lessonId])
}

// Unified ordering layer for lesson-attached activities (ContentItem + Quiz +
// Assignment). Each row points to exactly one of the three via discriminator
// `kind` + a per-kind nullable FK. Instructor drag-drop reorder updates this
// table only — underlying entity tables are untouched.
//
// Cuepoint-only quizzes (Quiz.cuepointOnly = true) and tournament-bound quizzes
// / assignments (tournamentMissionId != null) DO NOT get a LessonActivity row —
// they live outside the learner's lesson timeline.
enum LessonActivityKind {
  content
  quiz
  assignment
}

/// B11 — mức tương tác của một người học với một bài, cộng dồn qua nhiều lượt.
///
/// Vì sao là một bảng trạng thái chứ không phải chỉ event: câu hỏi cần trả lời
/// là "em này đọc bài đó bao lâu, cuộn tới đâu" — hỏi mỗi lần là phải quét lại
/// toàn bộ event của em đó. Event `lesson.engaged` vẫn được phát mỗi lượt ngồi
/// đọc để giữ được lịch sử; bảng này là bản tổng đã cộng sẵn.
///
/// `activeSec` chỉ đếm lúc tab thực sự hiện. Một tab mở suốt đêm không được
/// tính là ba tiếng học bài — nếu tính, con số này vô dụng ngay từ đầu.
model LessonEngagement {
  id       String @id @default(uuid())
  userId   String
  lessonId String
  // Denormalised — mọi truy vấn phân tích đều lọc theo khoá học trước.
  courseId String

  /// Tổng giây tab hiện và bài đang mở, cộng dồn mọi lượt.
  activeSec    Int @default(0)
  /// Cuộn sâu nhất từng đạt, 0-100.
  maxScrollPct Int @default(0)
  /// Tỉ lệ video xem được cao nhất từng đạt, 0-100. 0 khi bài không có video.
  maxVideoPct  Int @default(0)
  /// Số lượt mở bài. Mở đi mở lại nhiều lần là một tín hiệu khác hẳn đọc một mạch.
  sessionCount Int @default(0)
  /// Các đoạn video đã xem thật, hợp nhất — [[startSec,endSec], ...]. Khác
  /// maxVideoPct: mốc cao nhất không phân biệt được "xem liền mạch" với "tua
  /// tới cuối rồi tua lại xem đoạn đầu". Null khi bài không có video hoặc
  /// chưa từng nhận nhịp nào mang theo range.
  videoRanges Json?
  /// Vị trí phát gần nhất (giây) tại nhịp gần nhất — "điểm dừng" để biết bỏ
  /// dở ở đâu, khác với mốc cao nhất từng đạt.
  lastVideoPositionSec Int?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([courseId, lastSeenAt])
  @@index([lessonId])
}

model LessonActivity {
  id            String             @id @default(uuid())
  lessonId      String
  kind          LessonActivityKind
  // Exactly one of these is non-null, matching `kind`. Enforced application-side;
  // a Postgres CHECK constraint could be added later if needed.
  contentItemId String?            @unique
  quizId        String?            @unique
  assignmentId  String?            @unique
  orderIndex    Int
  createdAt     DateTime           @default(now())

  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  contentItem ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  quiz        Quiz?        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  assignment  Assignment?  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, orderIndex])
  @@index([lessonId, orderIndex])
}

// =====================================================================
// A3 — Learning Experience (Enrollment)
// =====================================================================

enum EnrollmentStatus {
  active
  completed
  dropped
  refunded
  // Truy cập đã hết hạn (CourseAccessPlan có durationMonths) — set bởi cron
  // reaper, không phải tay. Khác "dropped"/"refunded": lịch sử học tập giữ
  // nguyên, mua lại (extendEnrollmentAccess) là quay lại "active" ngay.
  expired
}

model Enrollment {
  id              String           @id @default(uuid())
  userId          String
  courseId        String
  // Lớp học (CourseSection) mà enrollment này thuộc về. courseId vẫn giữ
  // denormalized song song để không phải sửa các query hiện có đang lọc
  // theo courseId trực tiếp.
  sectionId       String
  // Frozen at enrollment time (A2 acceptance: học viên không bị break khi course update).
  courseVersion   Int
  status          EnrollmentStatus @default(active)
  enrolledAt      DateTime         @default(now())
  completedAt     DateTime?
  // A3 acceptance: resume position lưu mỗi 10s.
  lastLessonId    String?
  lastPositionSec Int?
  // Hạn truy cập khi mua theo CourseAccessPlan có thời hạn (1 năm, 2 năm...).
  // null = vĩnh viễn — mặc định, giữ nguyên hành vi của mọi enrollment trước
  // tính năng này (không cần backfill dữ liệu cũ).
  accessExpiresAt            DateTime?
  // Chống gửi trùng email nhắc hạn (cron enrollment-access-reminder). Reset về
  // null mỗi lần gia hạn để lần hết hạn kế tiếp lại được nhắc.
  accessExpiryReminderSentAt DateTime?

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course        @relation(fields: [courseId], references: [id])
  section CourseSection @relation(fields: [sectionId], references: [id])

  @@unique([userId, courseId])
  @@index([userId, status])
  @@index([sectionId])
  // Cron reaper (enrollment-access-expiry-check) quét theo cặp này mỗi ngày.
  @@index([status, accessExpiresAt])
}

// A3 — Note attached to a lesson, optionally to a content item, optionally
// pinned to a video timestamp. Private to the user who created it.
model Note {
  id            String   @id @default(uuid())
  userId        String
  lessonId      String
  contentItemId String?
  // Timestamp into the video (sec). Null for non-video notes.
  timestampSec  Int?
  body          String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  contentItem ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  @@index([userId, lessonId])
}

// =====================================================================
// A4 — Assessment Engine (Quiz)
// =====================================================================

enum QuestionType {
  mcq
  // Đợt 1 (thống nhất nhập câu hỏi Quiz/Bank/Exam) — trắc nghiệm nhiều đáp án
  // đúng, tách khỏi mcq (đúng 1 đáp án) để khớp ExamQuestionType. Trước đây
  // Quiz không tách "multi" — GV soạn mcq rồi tự tick nhiều đáp án đúng.
  multi
  true_false
  fill_in
  ordering
  matching
  numerical
  essay
  short_answer
  // Học viên kéo các token (chữ/cụm từ) từ pool thả vào các ô [[N]] trong
  // prompt. Mỗi option = 1 token; option.extra.blankIndex (số nguyên ≥ 1) là
  // chỉ số ô mà token này thuộc về. blankIndex null/undefined → distractor
  // (token nằm trong pool nhưng không thuộc ô nào).
  drag_drop_fill
}

model Quiz {
  id                  String   @id @default(uuid())
  // A quiz can attach to a lesson, or stand alone within a course.
  lessonId            String?
  courseId            String?
  title               String
  description         String?
  // 1-5 (per spec gamification XP table). Null until set by instructor.
  difficulty          Int?
  passThresholdPct    Int      @default(70)
  timeLimitSec        Int?
  maxAttempts         Int?
  randomizeOrder      Boolean  @default(false)
  // A4 acceptance: confidence rating bắt buộc trước khi xem đáp án (per-quiz toggle).
  requireConfidence   Boolean  @default(true)
  // Instructor-controlled visibility (false = hidden from all learners)
  isHidden            Boolean  @default(false)
  // True when this quiz was auto-created as a 1-question in-video cuepoint.
  // Filtered out of learner lesson-quiz lists; rendered with a badge in
  // instructor Question Bank. See docs/SPEC §6.1 cuepoint flow.
  cuepointOnly        Boolean  @default(false)
  // Set when this quiz backs a TournamentMission with verifyMode=AUTO_GRADE.
  // Filtered out of all course/lesson listings; reachable only in tournament UI.
  tournamentMissionId String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  lesson            Lesson?            @relation(fields: [lessonId], references: [id])
  questions         QuizQuestion[]
  attempts          QuizAttempt[]
  tournamentMission TournamentMission? @relation(fields: [tournamentMissionId], references: [id], onDelete: SetNull)
  lessonActivity    LessonActivity?
  gameSessions      GameSession[]

  @@index([lessonId])
  @@index([courseId])
}

model QuizQuestion {
  id          String       @id @default(uuid())
  quizId      String
  type        QuestionType
  prompt      String       @db.Text
  explanation String?      @db.Text
  points      Int          @default(1)
  orderIndex  Int
  // Type-specific metadata. Examples:
  //   numerical:   { expected: number, tolerance: number }
  //   short_answer: { acceptedRegexes: string[] }   // case-insensitive
  //   essay:       null (manual graded)
  extra       Json?
  // B11 — mục tiêu học tập của câu hỏi, dùng cho nước "feed up" của phản hồi
  // (Hattie & Timperley: mục tiêu là gì). Null ⇒ lùi về tiêu đề bài học.
  learningObjective String? @db.Text

  quiz      Quiz               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options   QuestionOption[]
  responses AnswerResponse[]
  skillTags QuestionSkillTag[]

  @@index([quizId, orderIndex])
}

model QuestionOption {
  id              String  @id @default(uuid())
  questionId      String
  label           String  @db.Text
  isCorrect       Boolean
  orderIndex      Int
  // A4.2: tag misconception cho từng đáp án sai — dùng cho Feedback Engine.
  misconceptionId String?
  // Type-specific extras. For `matching` questions: { side: "left"|"right", pairKey: string }
  // (two options with same pairKey + opposite sides form a match pair).
  extra           Json?

  question      QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  misconception Misconception? @relation(fields: [misconceptionId], references: [id])

  @@index([questionId])
}

enum AttemptStatus {
  in_progress
  submitted
  abandoned
}

model QuizAttempt {
  id          String        @id @default(uuid())
  quizId      String
  userId      String
  status      AttemptStatus @default(in_progress)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  scorePct    Float?
  passed      Boolean?

  quiz      Quiz             @relation(fields: [quizId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  responses AnswerResponse[]

  @@index([userId, quizId])
  @@index([quizId, status])
}

model AnswerResponse {
  id             String   @id @default(uuid())
  attemptId      String
  questionId     String
  // Shape per type:
  //   mcq/true_false/ordering: string[] (option IDs, ordered for ordering)
  //   fill_in/short_answer/essay: string
  //   numerical: number
  //   matching: Array<{ leftId: string, rightId: string }>
  response       Json
  // For essay: nullable until instructor grades. False until then.
  isCorrect      Boolean
  // Set true when grader/auto-grader has decided. Distinguishes pending essay
  // (needsGrading=true) from auto-graded incorrect answers.
  needsGrading   Boolean  @default(false)
  // Manually-awarded points for essay/short_answer when partial credit applies.
  manualScore    Int?
  // 1-5 confidence rating (A4.3).
  confidence     Int?
  /// KHÔNG phải thời gian làm câu này. Đây là số mili-giây tính từ lúc bắt đầu
  /// cả lượt làm bài, nên câu cuối luôn "lâu" hơn câu đầu bất kể khó dễ. Giữ
  /// lại vì dữ liệu cũ đã ghi theo nghĩa này; đo độ khó thì dùng `latencyMs`.
  responseTimeMs Int
  /// B12 — thời gian thật của riêng câu này: từ lúc câu hiện ra tới lúc người
  /// học chọn xong. Do máy khách đo, vì chỉ máy khách biết câu nào đang hiện.
  /// Null ở hàng trước B12 và ở hàng máy khách không gửi lên — để trống chứ
  /// không suy ra từ `responseTimeMs`, vì hai đại lượng đó khác nhau.
  latencyMs      Int?
  /// Số lần người học sửa lại đáp án của câu này. Đổi ý là một tín hiệu khác
  /// hẳn trả lời một phát ăn ngay, nhất là khi ghép với độ tự tin.
  revisionCount  Int      @default(0)
  answeredAt     DateTime @default(now())

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([questionId, isCorrect])
}

model Misconception {
  id          String   @id @default(uuid())
  // Stable code used by feedback templates, e.g. "confused_correlation_with_causation".
  code        String   @unique
  name        String
  description String   @db.Text
  createdAt   DateTime @default(now())

  options   QuestionOption[]
  flags     MisconceptionFlag[]
  templates FeedbackTemplate[]
}

// =====================================================================
// Bridge — Skill graph (B2 schema only; UI editor in Phase 2)
// =====================================================================

model Skill {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "linear_regression.basics"
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  prerequisites     SkillPrerequisite[]    @relation("SkillToPrerequisite")
  dependents        SkillPrerequisite[]    @relation("PrerequisiteToSkill")
  contentMappings   ContentSkillMapping[]
  questionTags      QuestionSkillTag[]
  learnerStates     LearnerSkillState[]
  feedbackTemplates FeedbackTemplate[]
  examPassageTags   ExamPassageSkillTag[]
  examQuestionTags  ExamQuestionSkillTag[]
  bankQuestionTags  BankQuestionSkillTag[]
}

// DAG edge: skill (skillId) requires prerequisiteSkillId.
// Cycle prevention enforced at application layer.
model SkillPrerequisite {
  skillId             String
  prerequisiteSkillId String
  createdAt           DateTime @default(now())

  skill        Skill @relation("SkillToPrerequisite", fields: [skillId], references: [id], onDelete: Cascade)
  prerequisite Skill @relation("PrerequisiteToSkill", fields: [prerequisiteSkillId], references: [id], onDelete: Cascade)

  @@id([skillId, prerequisiteSkillId])
  @@index([prerequisiteSkillId])
}

// Polymorphic by contentType.
// contentId references Lesson.id when contentType = "lesson", etc.
enum SkillContentType {
  lesson
  content_item
  quiz
}

model ContentSkillMapping {
  id             String           @id @default(uuid())
  contentType    SkillContentType
  contentId      String
  skillId        String
  // Coverage weight (0-1): how much this content covers the skill.
  // Used by Feedback Engine remediation query.
  coverageWeight Float            @default(1.0)
  createdAt      DateTime         @default(now())

  skill  Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  // Soft FK to Lesson (only when contentType = "lesson") — enforced app-side.
  // Cascade, not the Prisma default Restrict: a mapping is meaningless once its
  // lesson is gone, and Restrict blocked every lesson/module/course delete once
  // B1.5 started tagging every lesson.
  lesson Lesson? @relation("LessonSkill", fields: [contentId], references: [id], onDelete: Cascade, map: "csm_lesson_fk")

  @@unique([contentType, contentId, skillId])
  @@index([skillId])
  @@index([contentType, contentId])
}

model QuestionSkillTag {
  questionId String
  skillId    String
  weight     Float  @default(1.0)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  skill    Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([questionId, skillId])
  @@index([skillId])
}

// =====================================================================
// Phase 1 — Gamification: C1 (XP + Level)
// XP is per-course (spec §5.1). One row per (user, course).
// =====================================================================

model UserCourseProgress {
  id          String   @id @default(uuid())
  userId      String
  courseId    String
  xp          Int      @default(0)
  level       Int      @default(1)
  // Reserved for D5 growth-adjusted leaderboard (Phase 3+).
  growthScore Float?
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  // Hot index for course leaderboard queries (spec §7.3).
  @@index([courseId, xp])
}

// Append-only ledger of XP grants. Idempotency by (userId, reason, sourceId) —
// re-emitting the same gamification trigger never double-awards.
model XpTransaction {
  id         String   @id @default(uuid())
  userId     String
  courseId   String
  amount     Int // can be 0 when capped or speed-run, for audit
  reason     String // "lesson.completed", "quiz.passed.first_try", "xp.capped.daily", ...
  sourceId   String? // lesson id / attempt id / null
  occurredAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // sourceId nullable — Postgres treats nulls as distinct in unique, so events
  // without a source can be many rows; events with sourceId are deduped.
  @@unique([userId, reason, sourceId])
  @@index([userId, courseId, occurredAt])
  @@index([courseId, occurredAt])
}

// =====================================================================
// Phase 2 — Feedback Engine: B1 (Learner Modeling) + B3 (Diagnostic)
// =====================================================================

// Per-skill mastery estimate. One row per (user, skill).
// Updated by BKT after every quiz.question.answered for a skill-tagged question.
model LearnerSkillState {
  id                 String   @id @default(uuid())
  userId             String
  skillId            String
  // BKT P(L_t). Default 0.1 = "assume not yet mastered" prior (spec §4.1).
  masteryProbability Float    @default(0.1)
  attempts           Int      @default(0)
  correctCount       Int      @default(0)
  lastUpdatedAt      DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  // Hot index for "weak skill" queries (spec §7.3).
  @@index([userId, masteryProbability])
}

// Tracks how often a learner has triggered a specific misconception. Resolved
// flag flips when learner answers correctly the next time the same misconception
// path could have been chosen — Phase 2 leaves resolved logic for Phase 3+.
model MisconceptionFlag {
  id              String    @id @default(uuid())
  userId          String
  misconceptionId String
  count           Int       @default(1)
  firstDetectedAt DateTime  @default(now())
  lastDetectedAt  DateTime  @default(now())
  resolved        Boolean   @default(false)
  resolvedAt      DateTime?

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  misconception Misconception @relation(fields: [misconceptionId], references: [id], onDelete: Cascade)

  @@unique([userId, misconceptionId])
  @@index([userId, resolved])
}

enum FeedbackTemplateScope {
  generic
  per_misconception
  per_skill
}

// =====================================================================
// B9 — Research instrumentation. Every delivered feedback records its own
// analytic coordinates so the corpus can be described without re-reading
// the text: macro (which data/model produced it), meso (what the feedback
// targets), micro (how elaborated it is).
// =====================================================================

/// Meso — Hattie & Timperley feedback levels. `self` is deliberately never
/// emitted by the Feedback Engine: praise lives in the gamification channel.
enum FeedbackLevel {
  task
  process
  self_regulation
  self
}

/// Micro — elaboration depth, deepest layer present in the delivery.
///   kr         knowledge of response (it was wrong, nothing more)
///   kcr        knowledge of the correct response
///   kh         knowledge about how to proceed (remediation routing)
///   km         knowledge about the mistake (misconception explanation)
///   elaborated both km and kh
enum FeedbackElaboration {
  kr
  kcr
  kh
  km
  elaborated
}

/// Macro — what produced the text. `llm` and `hybrid` are reserved: today the
/// learner-facing path is deterministic and no model generates the body.
// B10 — điều kiện feedback của một lớp (CourseSection). Cho phép chạy thực
// nghiệm so sánh trong cùng một khoá học: lớp này nhận feedback cá nhân hoá,
// lớp kia nhận bản rút gọn. Mặc định `personalized` = hành vi trước B10, nên
// mọi lớp đang tồn tại không đổi gì sau migration.
enum FeedbackVariant {
  // Đầy đủ: template theo misconception + bài ôn gợi ý + đề xuất bài kế tiếp.
  personalized
  // Đối chứng: chỉ template chung, không nêu tên misconception, không gợi ý
  // bài ôn, không định tuyến adaptive. Vẫn thấy điểm và đáp án đúng.
  minimal
}

enum FeedbackSourceKind {
  rule_template
  misconception
  bkt_state
  llm
  hybrid
}

// Plain-text feedback templates. Phase 2 uses static strings; Phase 4 will
// allow LLM-generated bodies (with the same delivery pipeline).
model FeedbackTemplate {
  id              String                @id @default(uuid())
  scope           FeedbackTemplateScope
  misconceptionId String?
  skillId         String?
  body            String                @db.Text
  // Lower = higher priority when multiple templates match.
  priority        Int                   @default(100)
  // B9 — instructor-declared coordinates. Null = derive from `scope` at
  // generation time (see core-feedback/src/coding.ts).
  level           FeedbackLevel?
  elaboration     FeedbackElaboration?
  createdAt       DateTime              @default(now())

  misconception Misconception?     @relation(fields: [misconceptionId], references: [id], onDelete: Cascade)
  skill         Skill?             @relation(fields: [skillId], references: [id], onDelete: Cascade)
  deliveries    FeedbackDelivery[]

  @@index([scope, misconceptionId])
  @@index([scope, skillId])
}

// Audit + UI history of every feedback impression. body is snapshotted so
// editing the template later doesn't change historical text.
model FeedbackDelivery {
  id                   String               @id @default(uuid())
  userId               String
  attemptId            String?
  questionId           String?
  templateId           String?
  body                 String               @db.Text
  // Array of lesson IDs surfaced as remediation. Stored as Json for flexibility.
  remediationLessonIds Json
  // Optional learner rating 1-5 — picked up later in B8 quality loop.
  rating               Int?
  // ── B9 instrumentation ────────────────────────────────────────────────
  // Null on rows delivered before B9 shipped, and on rows the backfill could
  // not classify — never back-dated silently.
  // `level` is the dominant (highest) layer; `levels` is every layer present,
  // as a JSON string[], because one delivery genuinely carries several.
  level                FeedbackLevel?
  levels               Json?
  elaboration          FeedbackElaboration?
  sourceKind           FeedbackSourceKind?
  // Everything needed to reconstruct why this text was chosen: template scope,
  // misconception, skills, remediation, and the BKT prior at generation time.
  generationContext    Json?
  deliveredAt          DateTime             @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template FeedbackTemplate? @relation(fields: [templateId], references: [id])

  @@index([userId, deliveredAt])
  @@index([attemptId])
  // B9 — distribution-over-time queries for the feedback corpus.
  @@index([level, deliveredAt])
}

// =====================================================================
// Phase 1 — Gamification: C3 (Badges)
// =====================================================================

model Badge {
  id          String   @id @default(uuid())
  // Stable code referenced by handlers + tests, e.g. "first_step".
  code        String   @unique
  name        String
  description String   @db.Text
  emoji       String?
  // "milestone" for Phase 1. Future: "skill", "social", "hidden", "tournament".
  category    String   @default("milestone")
  // Reserved for D4 (Phase 3+) when rarity is computed from % of users earning.
  rarity      String   @default("common")
  // Configurable criteria JSON for future custom badges. Phase 1 milestone
  // logic is hard-coded so this is null.
  criteria    Json?
  createdAt   DateTime @default(now())

  awards UserBadge[]
}

// =====================================================================
// Phase 1 — Gamification: C4 (Streak per course)
// =====================================================================

model StreakRecord {
  id             String    @id @default(uuid())
  userId         String
  courseId       String
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  // UTC date of the most recent qualifying activity. Null = never active.
  lastActiveDate DateTime? @db.Date
  updatedAt      DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, currentStreak])
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  // Optional context — e.g. {courseId, attemptId} — for filtering on profile pages.
  context  Json?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId, earnedAt])
}

// =====================================================================
// Bridge — LearningEvent (event sourcing, append-only — see CLAUDE.md §5.1)
// =====================================================================

model LearningEvent {
  id          BigInt   @id @default(autoincrement())
  // Idempotency key — clients pass this to allow safe replay/retry.
  // NULL allowed for server-generated events.
  eventKey    String?  @unique
  // A5.8 (Q7) — Subject is either a User OR an ExamCandidate. At least one
  // must be set; enforced by raw-SQL CHECK in migration. Module B/C consumers
  // must skip if userId is null (candidate attempts don't update BKT/XP).
  userId      String?
  candidateId String?
  // Matches LearningEventType in @feedbackme/shared-types.
  eventType   String
  // Schema-validated per eventType (Zod schemas in core packages).
  payload     Json
  // Optional context — courseId/lessonId/quizId etc, for partition pruning.
  courseId    String?
  occurredAt  DateTime @default(now())

  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidate ExamCandidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  // Partial index for candidate-event lookup (added via raw SQL in migration).

  // Hot indexes per SPEC §7.3.
  @@index([userId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([courseId, occurredAt])
}

// =====================================================================
// Phase 0 — A5 Assignments (manual-graded coursework attached to a lesson).
// =====================================================================

// Generative learning activity taxonomy (Fiorella & Mayer 2016).
// Optional metadata on Assignment — null = plain instructor-graded coursework.
enum GenerativeActivityType {
  summarizing // Tóm tắt
  mapping // Vẽ sơ đồ / concept map
  drawing // Vẽ minh hoạ
  imagining // Tưởng tượng / hình dung
  self_explaining // Tự giải thích
  teaching // Dạy lại
  enacting // Diễn thực hành
}

enum AssessmentMode {
  instructor_graded
  self_assessed
  ai_assessed
  peer_reviewed
}

enum ResponseFormat {
  text
  file
  image
  audio
  video
  concept_map
  mixed
}

model Assignment {
  id                  String    @id @default(uuid())
  // Nullable so an assignment can stand alone (e.g. backing a
  // TournamentMission with verifyMode=MANUAL_REVIEW in a cross-course
  // tournament). DB CHECK enforces lessonId OR tournamentMissionId is set.
  lessonId            String?
  tournamentMissionId String?   @unique
  title               String
  description         String    @db.Text
  // Optional deadline shown to learners; not enforced server-side in MVP.
  dueAt               DateTime?
  // Maximum score the instructor can award (0..maxScore).
  maxScore            Int       @default(100)
  // Instructor-controlled visibility (false = hidden from all learners)
  isHidden            Boolean   @default(false)

  // Generative learning metadata. Null = traditional instructor-graded assignment.
  pedagogicalIntent GenerativeActivityType?
  responseFormat    ResponseFormat          @default(text)
  assessmentModes   AssessmentMode[]        @default([instructor_graded])
  requireSelfRating Boolean                 @default(false)
  requireReflection Boolean                 @default(false)
  countsTowardGrade Boolean                 @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson            Lesson?                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  tournamentMission TournamentMission?     @relation(fields: [tournamentMissionId], references: [id], onDelete: SetNull)
  submissions       AssignmentSubmission[]
  lessonActivity    LessonActivity?

  @@index([lessonId])
  @@index([tournamentMissionId])
  // `/me/dashboard` filters Assignment by dueAt >= now (or null) and orders by
  // dueAt asc to surface upcoming work. Without this index Postgres falls back
  // to a seq scan + sort once a course accumulates a few thousand assignments.
  @@index([dueAt])
}

enum SubmissionStatus {
  submitted
  graded
}

model AssignmentSubmission {
  id            String           @id @default(uuid())
  assignmentId  String
  userId        String
  body          String           @db.Text
  attachmentUrl String?
  status        SubmissionStatus @default(submitted)
  submittedAt   DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Grading fields — set when status flips to graded.
  score    Int?
  feedback String?   @db.Text
  graderId String?
  gradedAt DateTime?

  // Generative learning metadata captured at submission time.
  // selfRating: 1..5 metacognitive self-assessment.
  // reflection: free-text "what did I learn / where am I unsure".
  // aiFeedback: populated later by Feedback Engine (Phase 2+).
  selfRating Int?
  reflection String? @db.Text
  aiFeedback Json?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation("Submitter", fields: [userId], references: [id], onDelete: Cascade)
  grader     User?      @relation("Grader", fields: [graderId], references: [id])

  // Idempotent — one row per (assignment, user). Re-submission updates this row.
  @@unique([assignmentId, userId])
  @@index([userId, submittedAt])
  @@index([assignmentId, status])
}

// =====================================================================
// Phase 0 — A6 Forum/discussion. One thread per question, posts threaded
// flat (Phase 0 simple — no nested replies). Author can be a learner or
// instructor — moderation flags reserved for Phase 4.
// =====================================================================

model ForumThread {
  id             String   @id @default(uuid())
  lessonId       String
  authorId       String
  title          String
  body           String   @db.Text
  // Author or instructor can mark a post as the resolution.
  resolvedPostId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lesson Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  posts  ForumPost[]

  @@index([lessonId, createdAt])
  @@index([authorId])
}

model ForumPost {
  id        String   @id @default(uuid())
  threadId  String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// =====================================================================
// Phase 1 — C2 Quests. A static catalog of daily missions with target
// counters; per-user per-day progress rows track completion.
// =====================================================================

enum QuestKind {
  daily
  weekly
}

enum QuestObjective {
  complete_lessons
  pass_quizzes
  resolve_misconceptions
  earn_xp
}

model Quest {
  id          String         @id @default(uuid())
  // Stable code referenced by handlers + seeds, e.g. "daily_one_lesson".
  code        String         @unique
  name        String
  description String         @db.Text
  emoji       String?
  kind        QuestKind      @default(daily)
  objective   QuestObjective
  // Numeric target — interpretation depends on objective.
  target      Int            @default(1)
  // Reward XP granted once when target is met.
  rewardXp    Int            @default(20)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())

  userProgress UserQuestProgress[]
}

// =====================================================================
// Phase 3 — Tournament. 5-table schema per spec §7.5. Stub for Phase 0+
// (table only, no UI logic yet — UI lands in Phase 3).
// =====================================================================

enum TournamentStatus {
  draft
  published
  active
  ended
}

model Tournament {
  id                    String           @id @default(uuid())
  // Optional course context — null = platform-wide tournament.
  courseId              String?
  creatorId             String
  title                 String
  description           String           @db.Text
  status                TournamentStatus @default(draft)
  startsAt              DateTime
  endsAt                DateTime
  // Optional max team size (1 = solo, >1 = team-based).
  teamSize              Int              @default(1)
  // Total prize XP — distributed to top finishers per `prizeDistribution`.
  prizeXp               Int              @default(0)
  prizeDistribution     Json? // e.g. { "1": 50, "2": 30, "3": 20 } percentages
  // Cho phép đăng ký tham dự khi tournament đã chuyển sang `active`. Mặc định
  // true để giữ behavior cũ của solo; instructor có thể tắt để chốt danh sách
  // tại thời điểm startsAt (đặc biệt hữu ích cho team-based khi muốn lock
  // composition sau khi bắt đầu).
  allowLateRegistration Boolean          @default(true)
  // Khi nào người ngoài đội được xem bài nộp của các đội (trang showcase): "after_end" = chỉ sau khi
  // giải kết thúc (mặc định, tránh lộ bài cho đối thủ), "always" = xem ngay khi có bài nộp.
  showcaseMode          String           @default("after_end")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  course        Course?                  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  creator       User                     @relation("TournamentCreator", fields: [creatorId], references: [id])
  registrations TournamentRegistration[]
  missions      TournamentMission[]
  rankings      TournamentRanking[]
  teams         TournamentTeam[]
  judges        TournamentJudge[]

  @@index([status, startsAt])
  @@index([courseId, status])
}

model TournamentRegistration {
  id             String    @id @default(uuid())
  tournamentId   String
  userId         String
  // FK → TournamentTeam.id when registered as part of a team; null = solo
  // (only valid when tournament.teamSize == 1, or team was deleted).
  teamId         String?
  registeredAt   DateTime  @default(now())
  disqualifiedAt DateTime?

  tournament Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  team       TournamentTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, userId])
  @@index([tournamentId, teamId])
}

// Judges cho hackathon — instructor chỉ định N user chấm thay peer random.
// Khi mission PEER_REVIEW + isTeamSubmission + tournament có judges:
// hệ thống assign judges cho mỗi submission (thay vì peer chia ngẫu nhiên).
model TournamentJudge {
  id           String   @id @default(uuid())
  tournamentId String
  userId       String
  addedAt      DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation("TournamentJudge", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([tournamentId])
}

// Popular vote cho hackathon showcase. Mỗi voter chọn 1 project yêu thích
// per mission COLLECTIVE — kết quả là 1 leaderboard phụ ngoài ranking điểm.
model HackathonVote {
  id           String   @id @default(uuid())
  missionId    String
  voterUserId  String
  submissionId String
  createdAt    DateTime @default(now())

  mission    TournamentMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  voter      User              @relation("HackathonVoter", fields: [voterUserId], references: [id], onDelete: Cascade)
  submission MissionSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([missionId, voterUserId])
  @@index([submissionId])
}

// Team formed for a team-based tournament (teamSize > 1). Captain creates
// the team and gets a joinCode to share; teammates join with that code.
model TournamentTeam {
  id           String   @id @default(uuid())
  tournamentId String
  name         String
  captainId    String
  // 6-8 char alphanumeric shared by captain. Unique across all tournaments
  // so a code never collides; rotated when captain decides.
  joinCode     String   @unique
  createdAt    DateTime @default(now())

  tournament    Tournament               @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  captain       User                     @relation("TeamCaptain", fields: [captainId], references: [id])
  registrations TournamentRegistration[]

  @@unique([tournamentId, name])
  @@index([tournamentId])
}

// =====================================================================
// C5 — Mission Template catalog (admin-managed, domain-agnostic building blocks).
// Instructors pick a template when authoring tournament missions so they never
// have to type raw conditionType strings.
// =====================================================================
model MissionTemplate {
  id                 String   @id @default(uuid())
  // Stable code referenced by seed scripts and tests.
  code               String   @unique
  name               String // Human label shown in UI picker
  description        String   @db.Text
  emoji              String?
  // Maps to the conditionType switch in checkMissionCondition().
  conditionType      String
  // Sensible defaults — instructor may override.
  defaultValue       Int      @default(1)
  defaultMinScore    Int?
  // UI hints: which extra controls appear when this template is selected.
  hasMinScore        Boolean  @default(false)
  requiresSkillGroup Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  missions TournamentMission[]
}

enum MissionType {
  COURSE_LINKED // behavior-based on existing course content (uses conditionType)
  CUSTOM // content authored inline (markdown/embedded quiz/instructions)
  EXTERNAL // content lives outside platform (URL/3rd-party tool)
}

enum VerifyMode {
  AUTO_GRADE // inline quiz; reuses Quiz + QuizAttempt
  AUTO_CHECK // rule-based: URL pattern, webhook callback, file format
  PEER_REVIEW // N reviewers score by rubric, median scoring
  MANUAL_REVIEW // reuses Assignment + instructor grading flow
}

model TournamentMission {
  id             String   @id @default(uuid())
  tournamentId   String
  title          String
  description    String   @db.Text
  // Order in the tournament's mission list.
  orderIndex     Int
  // Points awarded for completing this mission.
  points         Int      @default(100)
  // Optional unlock dependency — must complete this mission first.
  prerequisiteId String?
  createdAt      DateTime @default(now())

  // ── Condition fields (C5) — used only when missionType=COURSE_LINKED ─
  templateId         String?
  conditionType      String?
  conditionValue     Int?
  conditionScope     String? @default("course")
  conditionMinScore  Int?
  conditionSkillCode String?

  // ── Custom missions (C5.x) ─────────────────────────────────────────
  // Default COURSE_LINKED keeps existing missions backwards-compatible.
  missionType MissionType @default(COURSE_LINKED)
  // Null for COURSE_LINKED (behavior auto-checked). Required for the others.
  verifyMode  VerifyMode?

  // Submission window — required when verifyMode is set; null means
  // "completion derived from behavior" (COURSE_LINKED).
  submissionDeadline DateTime?

  // CUSTOM/EXTERNAL content payload.
  // Shape varies by missionType:
  //   CUSTOM:   { markdown?, instructions?, attachments? }
  //   EXTERNAL: { url, instructions }
  contentPayload Json?

  // AUTO_CHECK rule: { type: "url_pattern" | "webhook" | "file_format", config: {...} }
  autoCheckRule Json?

  // PEER_REVIEW config.
  // rubric: [{ id, label, scale: "1-5"|"pass_fail", weight }]
  rubric                 Json?
  peerReviewerCount      Int?      @default(3)
  // Số review HOÀN THÀNH tối thiểu để tự chốt điểm 1 bài (quorum), TÁCH khỏi
  // peerReviewerCount (số reviewer được phân). Null = dùng peerReviewerCount
  // (hành vi cũ). Cho phép phân nhiều reviewer cho coverage mà vẫn chốt khi đủ
  // quorum. Luôn bị kẹp ≤ peerReviewerCount khi tính.
  reviewQuorum           Int?
  // Team peer-review only: true = chỉ captain (người nộp) được phân chấm chéo;
  // false (default) = mở cho mọi thành viên đang active của giải. Bỏ qua khi
  // mission không phải nộp-nhóm (solo luôn dùng pool người-đã-nộp).
  peerReviewCaptainsOnly Boolean   @default(false)
  reviewWindowEndAt      DateTime?
  // 0..1 — instructor sets per mission; required for PEER_REVIEW and
  // MANUAL_REVIEW to decide PASSED vs FAILED.
  passThreshold          Float?
  // How many times reviewWindowEndAt was auto-extended due to too few reviews
  // (max 2; after that, submissions fall back to manual review). AC-4.10.
  reviewExtendCount      Int       @default(0)
  // Team mode only: true = COLLECTIVE submission (1 captain nộp 1 lần,
  // tính cho cả đội). False = INDIVIDUAL (mỗi member nộp riêng, SUM).
  // Chỉ hợp lệ khi tournament.teamSize > 1 và verifyMode != AUTO_GRADE.
  isTeamSubmission       Boolean   @default(false)

  tournament     Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  prerequisite   TournamentMission?  @relation("MissionPrereq", fields: [prerequisiteId], references: [id])
  unlocks        TournamentMission[] @relation("MissionPrereq")
  template       MissionTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  submissions    MissionSubmission[]
  quiz           Quiz?
  assignment     Assignment?
  hackathonVotes HackathonVote[]

  @@unique([tournamentId, orderIndex])
  @@index([templateId])
  @@index([missionType, verifyMode])
}

enum MissionSubmissionStatus {
  pending // waiting for verify (peer window, manual grading, webhook)
  passed
  failed
  disqualified // anti-cheat (speed-run, collusion, etc.)
}

model MissionSubmission {
  id          String                  @id @default(uuid())
  missionId   String
  userId      String
  submittedAt DateTime                @default(now())
  // Shape varies by verifyMode:
  //   AUTO_GRADE:    { quizAttemptId }
  //   AUTO_CHECK:    { url? | fileUrl? | proof? }
  //   PEER_REVIEW:   { artifactMarkdown? | fileUrl? | url? }
  //   MANUAL_REVIEW: { assignmentSubmissionId }
  payload     Json
  status      MissionSubmissionStatus @default(pending)
  // 0..1; set after verify.
  finalScore  Float?
  verifiedAt  DateTime?

  mission           TournamentMission         @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewAssignments MissionReviewAssignment[]
  hackathonVotes    HackathonVote[]

  @@unique([missionId, userId])
  @@index([userId, submittedAt])
  @@index([missionId, status])
}

model MissionReviewAssignment {
  id           String    @id @default(uuid())
  submissionId String
  reviewerId   String
  assignedAt   DateTime  @default(now())
  dueAt        DateTime
  completedAt  DateTime?
  // [{ criterionId, score }] — score domain depends on rubric scale.
  scores       Json?
  comment      String?   @db.Text

  // Filled by close-review-window job.
  aggregateScore  Float?
  deltaFromMedian Float?
  xpAwarded       Int?
  flagged         Boolean @default(false)
  flagReason      String?

  submission MissionSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User              @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([submissionId, reviewerId])
  @@index([reviewerId, completedAt])
  @@index([submissionId, completedAt])
}

model TournamentRanking {
  id           String   @id @default(uuid())
  tournamentId String
  // Either userId (solo) or teamId (team) — exactly one is set.
  userId       String?
  teamId       String?
  rank         Int
  totalPoints  Int      @default(0)
  // Materialized view — rebuilt on every mission completion event.
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@unique([tournamentId, teamId])
  @@index([tournamentId, rank])
}

model UserQuestProgress {
  id          String    @id @default(uuid())
  userId      String
  questId     String
  // Day key — yyyy-mm-dd in UTC for daily quests, ISO week for weekly.
  periodKey   String
  count       Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  // Optional course context — only set when the triggering action was
  // course-scoped (lesson/quiz/misconception in a specific course).
  courseId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId, periodKey])
  @@index([userId, periodKey])
}

// =====================================================================
// Ranking board snapshots — written by `closePeriod` when a daily/weekly/
// monthly window ends (VN+07). Top-N per (scope, courseId?, period,
// periodKey) is persisted for history + rank-delta lookups; live ranking
// during the open period is computed from XpTransaction directly.
// =====================================================================

model LeaderboardEntry {
  id         String   @id @default(uuid())
  // "global" | "course"
  scope      String
  // Set only when scope = "course".
  courseId   String?
  // "daily" | "weekly" | "monthly" | "all_time"
  period     String
  // VN+07 bucket key: yyyy-mm-dd | yyyy-'W'ww | yyyy-mm | "all_time"
  periodKey  String
  userId     String
  rank       Int
  xp         Int
  capturedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Idempotent close: one row per (bucket, user).
  @@unique([scope, courseId, period, periodKey, userId])
  // Top-N read for a closed bucket.
  @@index([scope, courseId, period, periodKey, rank])
  // Look up "my rank yesterday" for delta.
  @@index([userId, period, periodKey])
}

// =====================================================================
// SCORM 1.2 — uploaded packages + per-user attempts (cmi.* state).
// Files unzipped to apps/web/uploads/scorm/{packageId}/ and served via a
// Next route handler. For prod, swap to S3/R2 (see API route).
// =====================================================================

model ScormPackage {
  id           String   @id @default(uuid())
  // SHA256 of original .zip — for dedupe + integrity check.
  fileHash     String
  // SCORM version detected from manifest. Phase 1 supports "1.2" only.
  version      String   @default("1.2")
  // Title pulled from imsmanifest.xml organization/title.
  title        String
  // Relative path to entry HTML (e.g. "shared/launchpage.html").
  entryHref    String
  // Original filename for display.
  originalName String
  // Total size of unzipped folder, bytes.
  sizeBytes    Int
  uploaderId   String
  uploadedAt   DateTime @default(now())

  uploader User           @relation("ScormUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  attempts ScormAttempt[]

  @@index([uploaderId, uploadedAt])
}

model ScormAttempt {
  id               String    @id @default(uuid())
  packageId        String
  userId           String
  // Optional course context — set when launched from a Lesson, null for sandbox.
  courseId         String?
  lessonId         String?
  // SCORM CMI fields (1.2 subset).
  lessonStatus     String    @default("not attempted") // passed/completed/failed/incomplete/browsed/not attempted
  completionStatus String?
  // Numeric score 0..100. Mapped from cmi.core.score.raw.
  scoreRaw         Float?
  scoreMin         Float?
  scoreMax         Float?
  // suspend_data (resume state) — string up to 64KB per spec.
  suspendData      String?   @db.Text
  // location (bookmark) — string up to 255 per spec.
  location         String?
  // Time spent in this attempt, "HHHH:MM:SS.SS" per spec.
  totalTime        String?
  // Timestamp of last LMSCommit.
  lastCommitAt     DateTime?
  // True after LMSFinish or browser close detected.
  finished         Boolean   @default(false)
  startedAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  package ScormPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([packageId, userId])
  @@index([userId, updatedAt])
  @@index([packageId, finished])
}

// =====================================================================
// LTI 1.3 — FeedBackMe acts as the Platform (LMS) embedding external tools.
// Each tool registers issuer + clientId + keys; learners launch via signed
// JWT id_token that the tool verifies against our public JWKS.
// =====================================================================

model LtiTool {
  id             String   @id @default(uuid())
  // Display name shown when authoring.
  name           String
  // Tool's canonical identifier (per spec). Usually the tool's domain.
  toolUrl        String
  // OIDC login initiation URL — where we redirect on launch.
  loginInitUrl   String
  // Where the tool POSTs its public key set (for incoming msg verify).
  // Either a JWKS URL or a static set; we store URL in MVP.
  jwksUrl        String?
  // The OAuth 2 client_id we issue to the tool when registering with us.
  clientId       String   @unique
  // Optional deployment ID — most tools hardcode "1".
  deploymentId   String   @default("1")
  // RSA private key (PEM) for signing id_tokens. Generated on creation.
  // For prod: store in KMS / Vault. MVP: PEM string in DB.
  privateKey     String   @db.Text
  // RSA public key kid (key ID) — surfaced via /.well-known/jwks.json.
  publicKeyKid   String
  // Public key (PEM) — duplicated in JSON form as JWKS for tool to fetch.
  publicKeyPem   String   @db.Text
  registeredById String
  createdAt      DateTime @default(now())

  registeredBy User        @relation("LtiToolRegistrar", fields: [registeredById], references: [id])
  launches     LtiLaunch[]

  @@index([clientId])
}

model LtiLaunch {
  id             String   @id @default(uuid())
  toolId         String
  userId         String
  // Optional course context.
  courseId       String?
  lessonId       String?
  // resource_link_id per spec — uniquely identifies the placement.
  resourceLinkId String
  // nonce + issuedAt — anti-replay. Same nonce can't be reused within 5 min.
  nonce          String   @unique
  // Issued at + expires (typically 5 min for OIDC id_tokens).
  issuedAt       DateTime @default(now())
  expiresAt      DateTime

  tool LtiTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([toolId, userId, issuedAt])
}

// =====================================================================
// H5P — interactive content (.h5p package). Player via h5p-standalone.
// Files unzipped to apps/web/uploads/h5p/{packageId}/ similar to SCORM.
// =====================================================================

model H5pPackage {
  id           String   @id @default(uuid())
  fileHash     String
  // Library identifier (mainLibrary from h5p.json), e.g. "H5P.MultiChoice".
  mainLibrary  String
  // Title from h5p.json metadata.
  title        String
  originalName String
  sizeBytes    Int
  uploaderId   String
  uploadedAt   DateTime @default(now())

  uploader User         @relation("H5pUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  attempts H5pAttempt[]

  @@index([uploaderId, uploadedAt])
}

model H5pAttempt {
  id        String   @id @default(uuid())
  packageId String
  userId    String
  courseId  String?
  lessonId  String?
  // Last xAPI score (0..1 normalized).
  scoreRaw  Float?
  scoreMax  Float?
  // Latest xAPI verb seen — "completed" / "answered" / "experienced".
  lastVerb  String?
  // Latest xAPI result success flag.
  success   Boolean?
  // Free-form xAPI state cache for resume.
  state     Json?
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package H5pPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([packageId, userId])
  @@index([userId, updatedAt])
}

// =====================================================================
// Integration credentials — admin-managed secrets (OpenAI, Stripe, etc).
// Values encrypted at rest with SECRETS_MASTER_KEY env var (AES-256-GCM).
// Plaintext NEVER returned to client; only server reads via getIntegrationSecret().
// =====================================================================

model IntegrationCredential {
  // Stable key, e.g. "openai", "stripe.secret", "vnpay.secret".
  key            String   @id
  // Base64( nonce(12) || ciphertext || authTag(16) ).
  encryptedValue String   @db.Text
  // Optional non-secret metadata, e.g. {"model": "gpt-4o-mini"}.
  meta           Json?
  updatedById    String
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

// =====================================================================
// AI Tutor — Phase 4. Per-lesson conversations + cost tracking.
// =====================================================================

model AiConversation {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  title     String? // First user message snippet, set after first turn.
  model     String   @default("gpt-4o-mini")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId, lessonId, updatedAt])
}

enum AiMessageRole {
  system
  user
  assistant
}

model AiMessage {
  id             String        @id @default(uuid())
  conversationId String
  role           AiMessageRole
  content        String        @db.Text
  // Tokens consumed by THIS message — for assistant messages = output tokens
  // generated; for user messages = input tokens billed when this turn was sent.
  tokensInput    Int?
  tokensOutput   Int?
  costUsd        Float?
  createdAt      DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Daily aggregate per user for rate/cost capping. Cheaper than scanning AiMessage.
model AiUsageLog {
  id           String   @id @default(uuid())
  userId       String
  // Day key — yyyy-mm-dd UTC.
  dayKey       String
  model        String
  // Total tokens + cost on this day, this model, this user.
  tokensInput  Int      @default(0)
  tokensOutput Int      @default(0)
  costUsd      Float    @default(0)
  // Number of completed turns (assistant messages) on this day.
  turns        Int      @default(0)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey, model])
  @@index([userId, dayKey])
  // Trần toàn hệ thống cộng tổng theo dayKey (không kèm userId), nên unique
  // ở trên không dùng được — cột dẫn đầu của nó là userId. Thiếu index này thì
  // mỗi lượt gọi AI là một lần quét toàn bảng, và bảng lớn thêm mỗi ngày một
  // dòng cho mỗi người dùng hoạt động.
  @@index([dayKey])
}

// =====================================================================
// Ví token AI (P0 của cơ chế hạn mức tháng + mua thêm).
//
// AiUsageLog trả lời "đã tiêu bao nhiêu"; hai bảng dưới đây trả lời "được tiêu
// bao nhiêu nữa". Tách đôi có chủ ý: sổ tiêu là dữ liệu quan sát (gộp theo
// ngày/model để làm báo cáo), còn ví là dữ liệu kế toán — phải cộng trừ chính
// xác từng đơn vị và phải truy được nguồn gốc của mỗi lần cộng.
// =====================================================================

enum AiTokenLedgerKind {
  monthly_grant // cấp đầu tháng theo vai trò, không cộng dồn
  purchase // mua thêm, cộng dồn
  consumption // tiêu khi gọi AI (amount âm)
  admin_adjustment // admin cộng/trừ tay
  refund
}

// Gói token bán cho người học. Giá bằng ĐỒNG, không phải cents — VND không có
// phần lẻ, để "priceCents" như Course là mời gọi nhân/chia nhầm 100 lần.
model AiTokenPackage {
  id        String   @id @default(uuid())
  name      String
  tokens    Int
  priceVnd  Int
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders AiTokenOrder[]
}

enum AiTokenOrderStatus {
  pending
  paid
  cancelled
}

// Đơn mua token, thanh toán bằng chuyển khoản rồi admin đối soát.
//
// KHÔNG dùng chung bảng Order: Order bắt buộc có courseId và mang hình dạng của
// Stripe (provider, providerRef). Luồng này khác hẳn — không có cổng thanh
// toán, thay vào đó là mã đối soát người mua ghi trong nội dung chuyển khoản
// và một người thật bấm xác nhận. Nhét hai luồng vào một bảng thì mỗi cột đều
// phải nullable và không cột nào còn ý nghĩa rõ ràng.
model AiTokenOrder {
  id          String             @id @default(uuid())
  userId      String
  packageId   String
  // Chốt tại thời điểm đặt: đổi giá gói không được làm thay đổi đơn đang chờ.
  tokens      Int
  priceVnd    Int
  // Mã người mua ghi vào nội dung chuyển khoản để admin đối soát.
  code        String             @unique
  status      AiTokenOrderStatus @default(pending)
  note        String?
  // Admin đã xác nhận nhận được tiền.
  confirmedBy String?
  confirmedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  package AiTokenPackage @relation(fields: [packageId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Sổ cái append-only. Số dư = tổng amount; AiTokenBalance chỉ là ảnh chụp
// dựng lại được từ đây (cùng lối với LearningEvent — §5.1).
model AiTokenLedger {
  id        String            @id @default(uuid())
  userId    String
  kind      AiTokenLedgerKind
  // Dương = cộng vào ví, âm = tiêu đi.
  amount    Int
  // Nguồn của dòng này: refType "month" | "order" | "usage" | "admin",
  // refId tương ứng "2026-09" | orderId | aiUsageLogId | adminUserId.
  refType   String?
  refId     String?
  note      String?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Chặn cộng trùng: webhook thanh toán gọi lại lần hai, hay cấp tháng chạy
  // hai lần do hai request song song, đều không được thành hai dòng.
  @@unique([userId, kind, refType, refId])
  @@index([userId, createdAt])
}

// Ảnh chụp số dư. Cập nhật trong cùng transaction với dòng ledger sinh ra nó,
// nên sai lệch là bug chứ không phải chuyện thường — và dựng lại được.
model AiTokenBalance {
  userId           String   @id
  // Phần đã mua: cộng dồn, không mất khi sang tháng.
  purchased        Int      @default(0)
  // Phần được cấp tháng này: reset mỗi tháng, không cộng dồn.
  monthlyRemaining Int      @default(0)
  // Tháng đang áp dụng, "YYYY-MM" theo giờ VN. Khác tháng hiện tại = chưa cấp.
  periodKey        String
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =====================================================================
// Site-wide settings — key/value store for admin-controlled flags.
// Keys: "payment.enabled" (bool string "true"/"false")
// =====================================================================

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// =====================================================================
// Payments — Stripe primary; VNPay/Momo can adopt the same Order shape.
// Course pricing lives on Course.priceCents; free courses keep null.
// =====================================================================

enum OrderStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentProvider {
  stripe
  vnpay
  momo
}

model Order {
  id          String          @id @default(uuid())
  userId      String
  courseId    String
  // Gói đã chọn lúc checkout (thời hạn truy cập). null = mua theo giá phẳng
  // Course.priceCents cũ (vĩnh viễn) — đường trước khi có CourseAccessPlan,
  // giữ nguyên để không phải migrate Order lịch sử.
  accessPlanId String?
  // Locked at order time so price changes don't affect pending orders.
  amountCents Int
  currency    String          @default("USD")
  provider    PaymentProvider @default(stripe)
  status      OrderStatus     @default(pending)
  // Provider-specific reference (Stripe Checkout Session id, VNPay txn ref, ...)
  providerRef String?         @unique
  paidAt      DateTime?
  refundedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  accessPlan CourseAccessPlan? @relation(fields: [accessPlanId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([courseId, status])
  @@index([status, createdAt])
}

// =====================================================================
// Gói bán khoá học theo thời hạn (1 năm, 2 năm, vĩnh viễn...) — thay cho giá
// phẳng duy nhất Course.priceCents. Chỉ admin platform được tạo/sửa (không
// phải instructor sở hữu khoá) vì đụng tới giá bán thật — xem CLAUDE.md.
// =====================================================================

model CourseAccessPlan {
  id             String   @id @default(uuid())
  courseId       String
  label          String // "1 năm", "2 năm", "Vĩnh viễn"
  // null = vĩnh viễn (không hết hạn). Dương = số tháng truy cập kể từ lúc mua.
  durationMonths Int?
  priceCents     Int
  currency       String   @default("VND")
  // Ẩn gói cũ khỏi checkout mà không xoá — Order lịch sử vẫn tham chiếu được.
  isActive       Boolean  @default(true)
  createdBy      String // admin userId — chi tiết actor nằm ở AuditLog
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([courseId, isActive])
}

// =====================================================================
// Mã kích hoạt khoá học có phí (thay cho luồng "liên hệ giảng viên" đã bỏ).
//
// Học viên trả tiền cho giảng viên ngoài hệ thống (chuyển khoản, tiền mặt —
// hệ thống không biết và không cần biết cách nào); giảng viên sinh một mã,
// gửi cho đúng người đó; học viên gõ mã vào là ghi danh ngay, không cần admin
// duyệt. Khác AiTokenOrder (mã đó chỉ để admin ĐỐI SOÁT sau khi đã xác minh
// tiền về) — mã này TỰ NÓ cấp quyền vào khoá, không ai xác minh lại, nên phải
// đủ dài để không đoán được: 12 ký tự trên bảng 32 ký tự (~10^18 khả năng),
// và endpoint redeem có rate-limit để chặn dò mã.
// =====================================================================

enum CourseAccessCodeStatus {
  unused
  redeemed
  revoked
}

model CourseAccessCode {
  id                 String                 @id @default(uuid())
  courseId           String
  code               String                 @unique
  status             CourseAccessCodeStatus @default(unused)
  // Chốt tại thời điểm sinh mã, cho báo cáo doanh thu — đổi giá khoá sau này
  // không được làm sai lệch số liệu của mã đã phát ra trước đó.
  priceCentsSnapshot Int?
  currency           String                 @default("VND")
  createdBy          String
  redeemedByUserId   String?
  redeemedAt         DateTime?
  note               String?
  createdAt          DateTime               @default(now())

  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator    User   @relation("CourseAccessCodeCreator", fields: [createdBy], references: [id])
  redeemedBy User?  @relation("CourseAccessCodeRedeemer", fields: [redeemedByUserId], references: [id])

  @@index([courseId, status])
  @@index([redeemedByUserId])
}

// =====================================================================
// Classroom Teaching Tools (Phase 0 Extension)
// =====================================================================

model ClassroomSession {
  id       String  @id @default(cuid())
  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  // Tool data
  randomPicks ClassroomRandomPick[]
  polls       ClassroomPoll[]
  wordClouds  WordCloud[]
  groupings   GroupingSession[]
  boards      InteractiveBoard[]
  whiteboards Whiteboard[]
  // Limio-Live present runs that lazily created this session to back their
  // poll/quiz/word_cloud slides (xem LiveSession).
  liveSessions LiveSession[]

  createdAt DateTime @default(now())

  @@index([lessonId, startedAt])
  @@index([startedAt])
}

// Random Student Picker
model ClassroomRandomPick {
  id        String           @id @default(cuid())
  sessionId String
  session   ClassroomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pickedAt DateTime @default(now())

  @@index([sessionId, pickedAt])
  @@index([userId])
}

// Quick Poll
model ClassroomPoll {
  id        String           @id @default(cuid())
  sessionId String
  session   ClassroomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  question    String
  options     String[] // JSON array: ["A", "B", "C", ...]
  isAnonymous Boolean  @default(true)

  createdById String?
  createdBy   User?   @relation("PollCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  votes ClassroomPollVote[]

  @@index([sessionId, createdAt])
  @@index([createdById, createdAt])
}

model ClassroomPollVote {
  id     String        @id @default(cuid())
  pollId String
  poll   ClassroomPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  choice String // index of selected option (0, 1, 2, ...)

  createdAt DateTime @default(now())

  @@index([pollId])
  @@index([userId])
}

// Word Cloud
model WordCloud {
  id        String           @id @default(cuid())
  sessionId String
  session   ClassroomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  prompt String // e.g., "Bạn học được gì hôm nay?"

  createdById String?
  createdBy   User?   @relation("WordCloudCreator", fields: [createdById], references: [id], onDelete: SetNull)

  submissions WordCloudSubmission[]

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdById, createdAt])
}

model WordCloudSubmission {
  id      String    @id @default(cuid())
  cloudId String
  cloud   WordCloud @relation(fields: [cloudId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  text String // Free text submission (1-2 words typically)

  createdAt DateTime @default(now())

  @@index([cloudId])
  @@index([userId])
}

// Interactive Board (Padlet-like)
// Standalone teaching tool — instructor tạo board từ /instructor/teaching-tools,
// sinh viên join qua code 6 chữ + post note text. Realtime broadcast qua SSE.
model InteractiveBoard {
  id   String @id @default(cuid())
  code String @unique // 6-char join code (uppercase alphanumeric)

  // Optional gắn vào ClassroomSession nếu instructor mở từ classroom flow.
  sessionId String?
  session   ClassroomSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  ownerId String
  owner   User   @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  title  String
  prompt String? // Tùy chọn (vd. "Bạn học được gì hôm nay?")
  status String  @default("open") // "open" | "closed"

  // Grid theo nhóm — tùy chọn, mặc định rỗng = board tự do (masonry, không cần chọn nhóm khi post).
  // GV tự đặt nhãn cột (vd "Nhóm 1", "Nhóm 2"), không liên quan GroupingSession.
  columns String[] @default([])

  // Chặn học viên dán (paste) text vào ô nội dung khi viết/sửa note — chống copy đáp án
  // từ nơi khác. Mặc định TẮT (cho phép dán như hành vi cũ). Chỉ áp dụng phía học viên
  // (/join/[code]) — GV luôn dán được bình thường ở view của mình.
  blockPaste Boolean @default(false)

  // Chế độ Whiteboard (Limio-Live): học viên vẽ 1 hình riêng rồi đăng lên bảng như 1 note ảnh,
  // thay vì gõ chữ. Cờ nằm ở board (không chỉ ở link tham gia) để học viên vào bằng cách nhập
  // mã 6 ký tự cũng thấy đúng khung vẽ.
  drawingMode Boolean @default(false)

  notes BoardNote[]

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  @@index([ownerId, createdAt])
  @@index([sessionId])
  @@index([status, createdAt])
}

model BoardNote {
  id      String           @id @default(cuid())
  boardId String
  board   InteractiveBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  // Optional — sinh viên không cần login để post (join bằng code).
  authorId   String?
  author     User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String // Tên hiển thị (bắt buộc, học viên tự nhập khi join)

  content       String // Note text (≤500 ký tự)
  color         String? // Hex, optional (random pastel client-side)
  attachmentUrl String? // URL ảnh / video / audio / YouTube / link bất kỳ (https only)
  hidden        Boolean @default(false) // Instructor moderate
  column        String? // Nhãn cột/nhóm lúc post (null nếu board không bật grid). Giữ nguyên khi cột bị đổi tên/xoá sau đó.

  createdAt DateTime @default(now())

  @@index([boardId, createdAt])
  @@index([boardId, hidden, createdAt])
  @@index([authorId])
}

// Whiteboard — vẽ tay tự do, đồng bộ real-time qua Redis Stream (không lưu
// từng nét vào Postgres — chỉ giữ `snapshot` đã reconcile theo version của
// element, giống InteractiveBoard nhưng canvas thay vì sticky-note).
// Join bằng code, không cần login — dùng chung pattern với InteractiveBoard,
// nhưng route join riêng (`/join/[code]` đã bị InteractiveBoard chiếm).
model Whiteboard {
  id   String @id @default(cuid())
  code String @unique // 6-char join code (uppercase alphanumeric)

  sessionId String?
  session   ClassroomSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  ownerId String
  owner   User   @relation("WhiteboardOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  title  String
  status String @default("open") // "open" | "closed"

  // C: Kiosk/triển lãm — set 1 lần lúc tạo (không đổi lại sau, giữ phạm vi
  // gọn như document mode). Bật thì: client tự gọi reset khi im lặng quá
  // lâu (không cần cron/BullMQ — kiosk là 1 tab luôn mở, tự theo dõi idle
  // của chính nó là đủ, xem WhiteboardCanvas.tsx).
  kioskMode Boolean @default(false)

  // B: Annotate tài liệu — ảnh nền mỗi trang, thứ tự = thứ tự trang. Rỗng =
  // bảng trắng tự do (Phase A, không đổi hành vi). Mỗi phần tử: { url }.
  pages       Json @default("[]")
  currentPage Int  @default(0) // trang GV đang chiếu — client theo dõi qua SSE `doc.page.changed`

  // Elements Excalidraw đã reconcile, map theo trang: { "0": [...], "1": [...] }.
  // Bảng trắng tự do chỉ dùng key "0" (1 trang ảo) — luôn cùng 1 shape cho cả
  // 2 chế độ để khỏi rẽ nhánh khắp API. KHÔNG lưu từng nét riêng lẻ.
  snapshot Json @default("{}")

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  @@index([ownerId, createdAt])
  @@index([sessionId])
  @@index([status, createdAt])
}

// Quick Grouping
model GroupingSession {
  id        String           @id @default(cuid())
  sessionId String
  session   ClassroomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  numGroups Int // Number of groups
  name      String? // Optional grouping name (e.g., "Discussion Groups")

  groups GroupMembership[]

  createdAt DateTime @default(now())

  @@index([sessionId])
}

model GroupMembership {
  id         String          @id @default(cuid())
  groupingId String
  grouping   GroupingSession @relation(fields: [groupingId], references: [id], onDelete: Cascade)

  groupNum Int // Group number (1, 2, 3, ...)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupingId, userId])
  @@index([groupingId, groupNum])
  @@index([userId])
}

// Timer Templates - Pre-made countdown timer configurations
// Allows instructors to create reusable timer templates with duration, notes, and music
model TimerTemplate {
  id              String   @id @default(uuid())
  userId          String // Template owner (instructor)
  courseId        String? // Optional: for course-specific templates
  name            String // e.g. "Group Discussion - 10min"
  description     String? // Optional description
  durationSeconds Int // Total duration in seconds (e.g., 600 for 10 minutes)
  notes           String?  @db.Text // Instructions/notes for students (chữ thường; hàng cũ có thể là HTML)
  noteSize        String? // Cỡ chữ ghi chú: sm | md | lg | xl. Null = mẫu cũ, dùng md
  musicId         String? // Selected background music identifier (optional)
  isPublic        Boolean  @default(false) // Can be shared with other instructors
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
  @@index([isPublic])
}

// Loại công cụ lớp học 1 event trong "kịch bản" có thể chạy — khớp 6 tool đã
// có sẵn ở apps/web/src/app/instructor/classroom/.
enum ClassroomToolType {
  random_picker
  quick_poll
  word_cloud
  grouping_tool
  countdown_timer
  whiteboard
}

// Kịch bản lớp học — thư viện cá nhân của giáo viên (KHÔNG gắn Course/Lesson
// nào), tái dùng cho bất kỳ buổi live nào.
//
// Chia sẻ (P1): isPublic = vào "chợ kịch bản" công khai; shareCode = link
// riêng gửi tay cho ai đó (không cần công khai). Cả 2 đường đều dẫn tới hành
// động "Sao chép về thư viện của tôi" (bản độc lập, không đồng bộ ngược) HOẶC
// "Tham gia đồng biên soạn" (trở thành collaborator, sửa chung bản gốc,
// đồng bộ real-time qua SSE topic `activity-plan:<planId>`).
model TeachingActivityPlan {
  id        String   @id @default(uuid())
  userId    String
  title     String
  isPublic  Boolean  @default(false)
  shareCode String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         TeachingActivityPlanItem[]
  collaborators TeachingActivityPlanCollaborator[]
  saves         TeachingActivityPlanSave[]
  likes         TeachingActivityPlanLike[]

  @@index([userId])
  @@index([isPublic])
}

// Đồng biên soạn — user trong bảng này sửa được plan gốc (không phải bản
// copy) y hệt chủ sở hữu, trừ các thao tác nhạy cảm (xoá plan, đổi
// public/shareCode, quản lý danh sách collaborator) chỉ chủ sở hữu làm được.
model TeachingActivityPlanCollaborator {
  id        String   @id @default(uuid())
  planId    String
  userId    String
  createdAt DateTime @default(now())

  plan TeachingActivityPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planId, userId])
  @@index([userId])
}

// Đánh dấu xem lại sau — KHÔNG copy vào thư viện để sửa, khác hẳn "copy".
model TeachingActivityPlanSave {
  id        String   @id @default(uuid())
  planId    String
  userId    String
  createdAt DateTime @default(now())

  plan TeachingActivityPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planId, userId])
  @@index([userId])
}

model TeachingActivityPlanLike {
  id        String   @id @default(uuid())
  planId    String
  userId    String
  createdAt DateTime @default(now())

  plan TeachingActivityPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planId, userId])
  @@index([userId])
}

// 1 event trong kịch bản. orderIndex chỉ để hiển thị lúc soạn — lúc trình
// chiếu trên lớp giáo viên chạy tuỳ ý, không ép theo thứ tự này.
model TeachingActivityPlanItem {
  id         String            @id @default(uuid())
  planId     String
  toolType   ClassroomToolType
  label      String
  // Config tối thiểu theo loại tool, vd { question, options } cho quick_poll,
  // { prompt } cho word_cloud — xem packages/core-lms/src/teaching-tools/activity-plans.ts
  config     Json?
  orderIndex Int
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  plan TeachingActivityPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, orderIndex])
}

// =====================================================================
// Gameshow — Wayground/Kahoot-style live competitive quiz session.
// Reuses Quiz/QuizQuestion (multiple_choice/true_false only) as question
// source, but is a standalone live-session layer: does NOT emit
// LearningEvent / feed XP-badge — score chỉ tồn tại trong phiên (product
// decision, không phải giới hạn kỹ thuật). Real-time qua Redis Streams
// (apps/web/src/lib/realtime) — cùng hạ tầng với Classroom tools ở trên.
// =====================================================================

model GameSession {
  id    String @id @default(cuid())
  code  String @unique // 6-char join code, pattern giống InteractiveBoard.code
  title String // Snapshot tên quiz/bộ câu hỏi lúc tạo — không join lại Quiz/QuestionSet để hiển thị.

  // Nguồn câu hỏi — đúng 1 trong 2 (validate ở service layer, không DB CHECK).
  // Câu hỏi thực tế được SNAPSHOT vào GameSessionQuestion lúc tạo phiên, nên
  // sửa/xoá Quiz hay QuestionSet sau đó không ảnh hưởng phiên đã tạo.
  quizId String?
  quiz   Quiz?   @relation(fields: [quizId], references: [id], onDelete: SetNull)

  questionSetId String?
  questionSet   GameQuestionSet? @relation(fields: [questionSetId], references: [id], onDelete: SetNull)

  hostId String
  host   User   @relation("GameSessionHost", fields: [hostId], references: [id], onDelete: Cascade)

  status                   String    @default("lobby") // lobby | running | reveal | ended
  currentQuestionIndex     Int       @default(0)
  currentQuestionStartedAt DateTime?

  // Chế độ nhóm kiểu Kahoot "Personal Devices" — mỗi học viên vẫn tự vào
  // bằng thiết bị riêng + tự bấm, nhưng gộp điểm theo đội (trung bình cộng,
  // xem GameParticipant.teamId + lib/gameshow/bus.ts getTeamStandings).
  teamModeEnabled Boolean @default(false)

  // Bộ màu giao diện chọn lúc tạo phiên (xem lib/gameshow/themes.ts). Chỉ là
  // key — CSS nằm ở globals.css; key lạ được client coi như mặc định.
  theme String @default("aurora")

  createdAt DateTime  @default(now())
  startedAt DateTime?
  endedAt   DateTime?

  questions    GameSessionQuestion[]
  teams        GameTeam[]
  participants GameParticipant[]
  answers      GameAnswer[]

  @@index([hostId, createdAt])
  @@index([status])
}

// Bộ câu hỏi GV tự soạn riêng cho Gameshow — KHÔNG dùng chung với
// Quiz/Question Bank (product decision), tái dùng được cho nhiều phiên.
model GameQuestionSet {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  title String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    GameQuestionSetItem[]
  sessions GameSession[]

  @@index([ownerId, createdAt])
}

model GameQuestionSetItem {
  id    String          @id @default(cuid())
  setId String
  set   GameQuestionSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  orderIndex   Int
  type         String // "mcq" | "true_false"
  prompt       String @db.Text
  timeLimitSec Int    @default(20)

  options GameQuestionSetOption[]

  @@unique([setId, orderIndex])
  @@index([setId])
}

model GameQuestionSetOption {
  id     String              @id @default(cuid())
  itemId String
  item   GameQuestionSetItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  label      String
  isCorrect  Boolean
  orderIndex Int

  @@index([itemId])
}

// Snapshot câu hỏi thực tế của 1 phiên — copy từ Quiz hoặc GameQuestionSet
// lúc tạo phiên. Mọi route điều khiển game (start/next/reveal/answer) chỉ
// đọc ở đây, không cần biết nguồn gốc là Quiz hay bộ tự soạn.
model GameSessionQuestion {
  id        String      @id @default(cuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  orderIndex   Int
  type         String
  prompt       String @db.Text
  timeLimitSec Int

  options GameSessionQuestionOption[]

  @@unique([sessionId, orderIndex])
  @@index([sessionId])
}

model GameSessionQuestionOption {
  id         String              @id @default(cuid())
  questionId String
  question   GameSessionQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  label      String
  isCorrect  Boolean
  orderIndex Int

  @@index([questionId])
}

// Đội trong 1 phiên — sinh sẵn theo teamCount lúc tạo phiên (tên/màu preset),
// học viên tự chọn đội lúc join. Điểm đội KHÔNG lưu ở đây — tính real-time
// (trung bình totalScore các thành viên) trong lib/gameshow/bus.ts.
model GameTeam {
  id        String      @id @default(cuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  name     String
  colorKey String // preset key cho màu badge — xem lib/gameshow/teams.ts

  createdAt DateTime @default(now())

  participants GameParticipant[]

  @@unique([sessionId, name])
  @@index([sessionId])
}

model GameParticipant {
  id        String      @id @default(cuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  teamId String?
  team   GameTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Optional — participant không cần đăng nhập (join bằng code + tên).
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  displayName String
  avatarKey   String // preset key, vd "fox", "cat" — xem lib/gameshow/avatars.ts

  // Token riêng để xác thực request answer/power-up — chống việc người khác
  // biết participantId (lộ qua leaderboard) rồi submit hộ/phá đáp án.
  participantToken String @unique

  totalScore Int @default(0)
  streak     Int @default(0)

  doublePointsUsed Boolean @default(false)
  immunityUsed     Boolean @default(false)

  joinedAt DateTime @default(now())

  answers GameAnswer[]

  @@unique([sessionId, displayName])
  @@index([sessionId, totalScore])
}

model GameAnswer {
  id        String      @id @default(cuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  participantId String
  participant   GameParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  questionId     String
  questionIndex  Int
  chosenOptionId String?
  isCorrect      Boolean
  responseTimeMs Int
  pointsAwarded  Int
  powerUpUsed    String? // "double_points" | "immunity"

  answeredAt DateTime @default(now())

  @@unique([participantId, questionIndex])
  @@index([sessionId, questionIndex])
}

// =====================================================================
// A7 — Exam (Online Exam with passage-based / IELTS-style questions)
// Spec: docs/A7-exam-P0-acceptance.md
// Separate from A4 Quiz: exam has server-authoritative timer, incident log,
// hybrid grading, and stimulus passages (text + image P0, audio/video later).
// =====================================================================

/// Đề này dùng để làm gì. Quyết định vài mặc định quay ngược chiều nhau:
///   assessment — đo học sinh. Hiện đáp án sau khi nộp, điểm tính cho học sinh,
///                chỉ lấy câu đã kết nạp vào kho.
///   field_test — đo câu hỏi. KHÔNG hiện đáp án (hiện là đốt câu hỏi: lớp sau
///                không thử nghiệm sạch được nữa), điểm không nên tính cho học
///                sinh vì đề chưa kiểm định, và được phép chở câu nháp.
enum ExamPurpose {
  assessment
  field_test
}

enum ExamStatus {
  draft
  published
  archived
}

// A5.8 — How candidates enter the exam.
//   authenticated  — current behaviour: User must sign in + be enrolled.
//   open_code      — 1 shared `Exam.openCode`; anyone with the code can take
//                    the exam. Candidate types name + phone + email (Q1).
//   assigned_code  — instructor pre-creates ExamCandidate rows, each with a
//                    unique `accessCode`. No FeedBackMe account needed.
enum ExamAccessMode {
  authenticated
  open_code
  assigned_code
}

// PR2.13 — Nguồn sinh mã access cho assigned_code candidate.
// `random` (default): 8 ký tự alphanumeric server-side generate.
// `student_code`: dùng MSSV làm accessCode (chỉ áp khi có giám thị vật lý).
enum AssignedCodeSource {
  random
  student_code
}

enum ExamAttemptPolicy {
  single
  multi
}

enum ExamGradingMode {
  auto
  manual
  hybrid
}

enum ExamProctoringLevel {
  none
  basic
  strict
}

enum ExamAttemptStatus {
  in_progress
  submitted
  auto_submitted
  graded
  flagged
}

enum ExamQuestionType {
  mcq
  multi
  true_false_notgiven
  gap_fill
  short_answer
  essay
  // Đợt 1 (thống nhất nhập câu hỏi Quiz/Bank/Exam) — trước là "matching_heading"
  // (P1, chưa từng build, luôn bị chặn bởi configSchemaForType → z.never()).
  // Đổi tên "matching", lấy cấu trúc Ghép đôi đã chạy tốt bên Quiz làm chuẩn
  // (xem MatchingConfig ở packages/core-lms/src/exam/schemas.ts). Không có
  // dòng dữ liệu nào dùng giá trị cũ nên đổi tên an toàn, không cần backfill.
  matching
  ordering
  numerical
  drag_drop_fill
}

enum ExamAssetType {
  image
  audio // P1
  video // P2
}

enum ExamPassageAudioPolicy {
  free_replay
  limited_replay
  once_only
}

enum ExamPassageRevealMode {
  all_at_once
  sequential // P2
}

enum ExamIncidentType {
  tab_blur
  fullscreen_exit
  paste
  multi_tab
  network_lost
  multi_face // P1+
}

model Exam {
  id                     String              @id @default(uuid())
  // A7.x — nullable: đề có thể không gắn khoá học nào (đề độc lập, vào bằng
  // mã/link mời). Khi null, createdById là chủ sở hữu duy nhất (xem CHECK
  // constraint exam_courseid_or_createdby_check ở migration).
  courseId               String?
  title                  String
  // A6.6 (UI) — với kind=oral, đây CŨNG là nội dung hiện ở panel bên phải
  // phòng vấn đáp (richtext, cho phép chèn ảnh) — gộp làm 1 với mô tả chung,
  // không tách riêng oralInstructionsHtml nữa (2 field trùng mục đích, GV dễ
  // nhầm điền nhầm chỗ). Null/rỗng = panel hiện placeholder mặc định.
  description            String?             @db.Text
  durationMin            Int
  openAt                 DateTime
  closeAt                DateTime
  attemptPolicy          ExamAttemptPolicy   @default(single)
  // Số lượt tối đa mỗi người khi attemptPolicy=multi (chỉ đề vấn đáp AI). Bỏ qua khi single.
  maxAttempts            Int                 @default(3)
  gradingMode            ExamGradingMode     @default(hybrid)
  proctoringLevel        ExamProctoringLevel @default(none)
  // NGỪNG DÙNG: đề thi chỉ trả về điểm; đạt hay không do quy chế bên ngoài
  // quyết định, không phải thuộc tính của gói đề. Cột còn đây để dữ liệu cũ
  // không mất; xoá ở đợt migration riêng cùng openAt/closeAt.
  passScore              Int                 @default(50)
  shuffleQuestions       Boolean             @default(true)
  shuffleOptions         Boolean             @default(true)
  // When true, learner sees per-question correct/incorrect after final grade.
  showResultsAfterSubmit Boolean             @default(true)
  status                 ExamStatus          @default(draft)
  // Xem ExamPurpose. Mặc định assessment để đề cũ giữ nguyên hành vi.
  purpose                ExamPurpose         @default(assessment)
  publishedAt            DateTime?
  // A5.8 — Code-based access. Default keeps existing behaviour intact.
  accessMode             ExamAccessMode      @default(authenticated)
  // open_code mode: 6-8 ký tự alphanumeric, instructor có thể rotate.
  openCode               String?             @unique
  // open_code mode: cap số candidate registration để chống spam.
  openMaxAttempts        Int?
  // PR2.13 — Khi accessMode = assigned_code, mã access có thể là random hoặc
  // chính là MSSV của SV. Random là mặc định an toàn; MSSV chỉ nên bật khi
  // ca thi có giám thị vật lý kiểm tra thẻ.
  assignedCodeSource     AssignedCodeSource  @default(random)
  // A5.5 — User tạo đề này. Nullable cho exam legacy; backfill = primary
  // instructor của course. Tăng User.examsCreatedCount khi publish exam mới.
  createdById            String?
  // A6.1 — Vấn đáp AI. Default `written` giữ nguyên hành vi cho mọi Exam có
  // trước cột này — toàn bộ đang là thi viết. Không đổi qua lại sau khi tạo:
  // đổi kind = tạo Exam mới (xem oral-materials.ts).
  kind                   ExamKind            @default(written)
  // A6.6 — chỉ áp dụng khi kind=oral.
  answerMode             OralAnswerMode      @default(text)
  // A6.3/A6.6 — ngôn ngữ hỏi-đáp; xem enum OralExamLanguage. Bất biến sau khi
  // tạo giống answerMode/kind — đổi ngôn ngữ giữa chừng buổi thi vô nghĩa.
  language               OralExamLanguage    @default(vi)
  // A6.3 (UI) — hướng dẫn phong cách/luật hỏi cho AI giám khảo (vd "không để
  // SV dẫn dắt", "hỏi hết chủ đề này mới sang chủ đề khác"), chèn thêm vào
  // system prompt mỗi lượt hỏi — xem examinerChat.ts buildSystemPrompt. Text
  // thuần, không phải richtext (chỉ để nhét vào prompt, không hiện cho SV).
  examinerInstructions   String?             @db.Text
  // A6.7 — bật thì buổi vấn đáp có PHA KHỞI ĐỘNG tách riêng: lượt AI đầu chỉ chào,
  // giới thiệu và hỏi một câu làm quen (không hỏi kiến thức); câu kiến thức đầu tiên
  // đến ở lượt sau. Tắt (mặc định) = hành vi cũ: chào rồi hỏi luôn trong cùng lượt.
  oralWarmup             Boolean             @default(false)
  // A6.8 — cách AI phản hồi TRONG buổi: exam = trung lập (chỉ ghi nhận rồi hỏi tiếp, dùng cho bài thi);
  // coaching = sau mỗi câu trả lời có 1 nhận xét ngắn cụ thể + 1 gợi ý/phản biện (dùng cho bài luyện).
  oralFeedbackMode       OralFeedbackMode    @default(exam)
  // A6.8 — bật thì lời kết buổi có thêm "Nhìn lại buổi vấn đáp": vài điểm làm tốt / cần cải thiện, KHÔNG có điểm số.
  oralClosingSummary     Boolean             @default(false)
  // A6.4 (UI) — rubric chấm điểm GV tự gõ/sửa, dùng khi AI đề xuất điểm sau
  // buổi thi. KHÔNG dùng cơ chế "tài liệu" (OralExamMaterial, khoá sau khi
  // publish để công bằng câu hỏi) vì rubric chỉ ảnh hưởng cách CHẤM sau này,
  // không ảnh hưởng câu hỏi SV nhận lúc thi — nên sửa được bất cứ lúc nào kể
  // cả đề đã publish/có lượt thi. Thay thế OralExamMaterial.type=rubric cũ
  // (không xoá dữ liệu material cũ, chỉ không dùng để chấm nữa).
  oralRubricText         String?             @db.Text
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  course        Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy     User?              @relation("ExamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  wizardConfig  ExamWizardConfig?
  blueprint     ExamBlueprint?
  passages      ExamPassage[]
  questions     ExamQuestion[]
  attempts      ExamAttempt[]
  assets        ExamAsset[]
  messages      ExamMessage[]
  candidates    ExamCandidate[]
  schedules     ExamSession[]
  sections      ExamSection[]
  rooms         ExamRoom[]
  oralMaterials OralExamMaterial[]
  oralTopics    OralExamTopic[]

  @@index([courseId, status])
  @@index([status, openAt, closeAt])
  @@index([createdById])
}

enum ExamKind {
  written
  oral
}

// A6.6 — Vấn đáp AI: SV trả lời bằng gõ chữ hay giọng nói. Chỉ có ý nghĩa khi
// kind=oral; mặc định text để đề cũ không đổi hành vi.
enum OralAnswerMode {
  text
  voice
}

// A6.8 — xem Exam.oralFeedbackMode.
enum OralFeedbackMode {
  exam
  coaching
}

// A6.3/A6.6 — Ngôn ngữ hỏi-đáp của buổi vấn đáp. Chỉ có ý nghĩa khi kind=oral.
// Cần khai báo tường minh (không suy đoán từ câu trả lời của SV) vì câu hỏi
// MỞ MÀN chưa có câu trả lời nào để AI dựa vào — thiếu cột này, câu hỏi đầu
// dễ bị trộn tiếng Anh/Việt (đã gặp thật khi test), và STT (Whisper) cũng
// cần biết trước ngôn ngữ để nhận dạng chính xác thay vì đoán.
enum OralExamLanguage {
  vi
  en
  zh
}

// =====================================================================
// A6.1 — Vấn đáp AI: tài liệu GV upload để "giảng viên ảo" dựa vào khi hỏi.
// Spec: chưa có trong SPEC.docx — bổ sung khi viết acceptance criteria đầy đủ.
//
// KHÔNG BAO GIỜ lộ cho sinh viên qua bất kỳ endpoint nào — chỉ AI (A6.3) đọc.
// File lưu ở storage layer `private` (không phải `public` như ExamAsset),
// đúng vì đây không phải nội dung hiển thị cho người học.
// =====================================================================
enum OralExamMaterialType {
  document
  topic_list
  rubric
}

model OralExamMaterial {
  id     String               @id @default(uuid())
  examId String
  type   OralExamMaterialType
  title  String
  // Null cho topic_list nhập tay — không có file đứng sau.
  s3Key     String?
  mimeType  String?
  sizeBytes Int?
  // Text thuần: trích từ file (pdf/docx/txt/md) khi type=document/rubric, hoặc
  // chính nội dung GV gõ khi type=topic_list. Null nếu parse file thất bại
  // (vd PDF scan không có text layer) — không suy đoán, để trống cho rõ ràng
  // là chưa trích được gì, GV cần biết để xử lý (thay file khác).
  extractedText String? @db.Text
  orderIndex    Int
  uploadedById  String
  uploadedAt    DateTime @default(now())

  exam       Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("OralExamMaterialUploader", fields: [uploadedById], references: [id])
  chunks     OralExamMaterialChunk[]

  @@index([examId, orderIndex])
}

// A6.2 — mảnh nhỏ cắt ra từ OralExamMaterial.extractedText, kèm vector ngữ
// nghĩa (OpenAI text-embedding-3-small, 1536 chiều) để "giảng viên ảo" (A6.3)
// tìm đúng đoạn liên quan thay vì phải đọc nguyên tài liệu mỗi lượt hỏi.
// `embedding` là Unsupported vì Prisma Client chưa có kiểu vector native —
// đọc/ghi qua raw SQL (packages/core-feedback/src/oralExam/).
model OralExamMaterialChunk {
  id         String                       @id @default(uuid())
  materialId String
  chunkIndex Int
  chunkText  String                       @db.Text
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())

  material OralExamMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, chunkIndex])
}

// A6.7 — Chủ đề (tình huống) giao cho từng sinh viên trong đề vấn đáp AI. Khi sinh viên
// bắt đầu lượt thi, hệ thống GIAO một chủ đề (chia đều, xem oral-topics.ts) và AI giám
// khảo chỉ hỏi trong chủ đề đó — thay cho việc nhờ AI tự ánh xạ theo dữ kiện gõ trong
// hướng dẫn (dễ sai, và không kiểm chứng được). `brief` là phần AI đọc; sinh viên chỉ
// được nghe tiêu đề + mô tả từ chính AI. Khoá sau khi publish như tài liệu (công bằng).
model OralExamTopic {
  id         String   @id @default(uuid())
  examId     String
  title      String
  brief      String   @db.Text
  // A6.8 — phần sinh viên ĐƯỢC ĐỌC (thẻ "Tình huống của bạn" ghim trong phòng thi). Tách khỏi `brief` vì
  // brief chứa dữ kiện AI chỉ đưa ra ở câu phát biểu vấn đề. Trống = không hiện thẻ.
  studentBrief String? @db.Text
  orderIndex Int
  createdAt  DateTime @default(now())

  exam     Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  attempts ExamAttempt[]

  @@index([examId, orderIndex])
}

// A6.3 — 1 lượt hỏi/đáp trong buổi vấn đáp AI. Gắn vào ExamAttempt (bảng đã
// có, dùng chung với thi viết) chứ không phải bảng riêng — để màn hình GV
// xem danh sách bài làm dùng chung được cho cả 2 loại đề.
enum OralExamTurnRole {
  examiner
  student
}

model OralExamTurn {
  id           String           @id @default(uuid())
  attemptId    String
  role         OralExamTurnRole
  content      String           @db.Text
  tokensInput  Int?
  tokensOutput Int?
  createdAt    DateTime         @default(now())

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, createdAt])
}

// A6.4 — chấm điểm buổi vấn đáp. AI đề xuất, GV duyệt/sửa — điểm CHỈ có hiệu
// lực (status != pending_review) sau khi GV xác nhận. Tách bạch rõ AI vs
// người: `aiSuggestedScore` không bao giờ bị ghi đè bởi `instructorScore`,
// hai cột riêng để sau này phân tích AI chấm lệch người bao nhiêu.
enum OralExamEvaluationStatus {
  pending_review
  approved
  overridden
}

model OralExamEvaluation {
  id       String @id @default(uuid())
  attemptId String @unique

  aiSuggestedScore  Float?
  // [{ topic: string, note: string }] — theo từng chủ đề/câu hỏi đã hỏi.
  aiRubricBreakdown Json?
  aiSummary         String? @db.Text

  instructorScore Float?
  instructorNotes String?                  @db.Text
  status          OralExamEvaluationStatus @default(pending_review)
  gradedAt        DateTime?
  gradedById      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  gradedBy User?       @relation("OralExamEvaluationGrader", fields: [gradedById], references: [id], onDelete: SetNull)
}

// =====================================================================
// A5.5 — Wizard "Tạo đề trong 3 bước" (Cơ bản mode)
// 1:1 với Exam. Exam tạo bằng wizard có row này; tạo bằng Nâng cao mode
// (full editor) thì không. Mở lại exam có wizardConfig → render wizard
// pre-filled; không có → render full editor.
// Đề đã publish: wizardConfig immutable (PATCH reject với 409).
// =====================================================================
model ExamWizardConfig {
  examId            String   @id
  // Bước 1 — scope nội dung: mảng Lesson.id đã tick. Pool derive qua
  // ContentSkillMapping(lessonIds) → skillIds.
  lessonIds         String[]
  // Bước 2 — cấu hình
  questionCount     Int
  // { remember_understand: 60, apply: 30, analyze_plus: 10 } — tổng = 100.
  bloomMix          Json
  // "basic" | "balanced" | "challenge" | "adaptive_to_class"
  // adaptive_to_class fallback về "balanced" khi cohort chưa có
  // LearnerSkillState data.
  difficultyProfile String
  // Bước 3 — phát đề
  // "single" | "shuffled_per_student" | "multi_session"
  distributionMode  String
  // multi_session only: số ca thi (2-8). Khi set, hệ thống tạo N ExamSession
  // row tương ứng.
  sessionCount      Int?
  // Cờ "Tự cân bằng điểm giữa các ca" — default ON cho multi_session,
  // ignored cho mode khác.
  autoEquating      Boolean  @default(true)
  // "basic" | "advanced" — để phân biệt exam tạo bằng wizard vs full editor.
  createdMode       String   @default("basic")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
}

// =====================================================================
// S4 — Blueprint Editor (Table of Specifications)
// Instructor explicitly sets question-count per (cognitiveLevel × difficulty)
// cell per lesson selection. assembleFromBlueprint() converts this into a
// bucketed poolFilter on an ExamSection.
// =====================================================================
model ExamBlueprint {
  examId     String   @id
  // "skill_matrix" (Bloom × difficulty cells, scope=lessonIds → skills)
  // | "topic_only" (per-topic cells with optional Bloom/difficulty narrowing,
  //   scope=all course banks instructor can edit).
  mode       String   @default("skill_matrix")
  // Lesson IDs in scope (skill_matrix mode); mapped to skillIds via ContentSkillMapping.
  // Empty in topic_only mode.
  lessonIds  String[] @default([])
  // Reserved for future explicit-pick UX in topic_only mode. Empty = auto-resolve from course.
  bankIds    String[] @default([])
  // skill_matrix: [{cognitiveLevel, difficulty, count}]
  // topic_only:  [{topic, cognitiveLevel?, difficulty?, count}]
  cells      Json     @default("[]")
  totalCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model ExamPassage {
  id            String                 @id @default(uuid())
  examId        String
  title         String
  // Tiptap doc JSON. Image/audio nodes reference ExamAsset.id.
  contentJson   Json
  orderIndex    Int
  audioPolicy   ExamPassageAudioPolicy @default(free_replay)
  // Only when audioPolicy = limited_replay. Range 1-10 (app-validated).
  maxAudioPlays Int?
  revealMode    ExamPassageRevealMode  @default(all_at_once)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  exam      Exam                  @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions ExamQuestion[]
  skillTags ExamPassageSkillTag[]

  @@unique([examId, orderIndex])
  @@index([examId])
}

model ExamPassageSkillTag {
  passageId String
  skillId   String
  weight    Float  @default(1.0)

  passage ExamPassage @relation(fields: [passageId], references: [id], onDelete: Cascade)
  skill   Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([passageId, skillId])
  @@index([skillId])
}

model ExamAsset {
  id           String        @id @default(uuid())
  examId       String
  type         ExamAssetType
  s3Key        String
  mimeType     String
  sizeBytes    Int
  // image: {width, height}; audio/video: {durationSec, sampleRate?}
  metadata     Json?
  // Required for image (app-validated). Accessibility + dispute evidence.
  altText      String?
  // Required for audio (P1) when audioPolicy != free_replay.
  transcript   String?       @db.Text
  uploadedById String
  uploadedAt   DateTime      @default(now())

  exam       Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("ExamAssetUploader", fields: [uploadedById], references: [id])

  @@index([examId, type])
}

model ExamQuestion {
  id             String           @id @default(uuid())
  examId         String
  passageId      String?
  type           ExamQuestionType
  prompt         String           @db.Text
  // Type-specific payload:
  //   mcq/multi: { options: [{id, label, isCorrect}] }
  //   true_false_notgiven: { correct: "true"|"false"|"notgiven" }
  //   gap_fill: { blanks: [{ id, acceptedAnswers: string[], matchMode }] }
  //   short_answer: { acceptedAnswers: string[], matchMode }
  //   essay: { rubric?: string, minWords?: number }
  //   matching_heading (P1): { headings: [...], items: [...], correctPairs: [...] }
  config         Json
  // Span in passage that justifies the answer — for diagnostic feedback (P1+).
  // { startOffset, endOffset } against passage.contentJson plain-text view.
  evidenceSpan   Json?
  points         Int              @default(1)
  // Order WITHIN passage. Null for standalone.
  orderInPassage Int?
  // Order in the exam (used when passageId is null, or for top-level ordering).
  orderInExam    Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  exam        Exam                   @relation(fields: [examId], references: [id], onDelete: Cascade)
  passage     ExamPassage?           @relation(fields: [passageId], references: [id], onDelete: Cascade)
  answers     ExamAnswer[]
  skillTags   ExamQuestionSkillTag[]
  fromBank    ExamQuestionFromBank?
  sectionItem ExamSectionItem?
  stats       ExamQuestionStats?

  @@index([examId, orderInExam])
  @@index([passageId, orderInPassage])
}

model ExamQuestionSkillTag {
  questionId String
  skillId    String
  weight     Float  @default(1.0)

  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  skill    Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([questionId, skillId])
  @@index([skillId])
}

model ExamAttempt {
  id                   String            @id @default(uuid())
  examId               String
  // A5.8 — Subject: either an authenticated User OR an anonymous ExamCandidate.
  // Exactly one must be set (enforced by raw-SQL CHECK in the migration).
  userId               String?
  candidateId          String?
  // Ca thi mà bài làm này thuộc về, chốt ngay lúc bắt đầu bài.
  //
  // Phải LƯU chứ không đoán lại: assertEligibleForExam chọn ca theo "ca nào
  // đang mở lúc này", nên lúc học sinh xem lại kết quả, đoán lại có thể ra ca
  // khác (ca cũ đã đóng, ca mới vừa mở) — chính sách lộ đáp án sẽ nhảy lung
  // tung. Thí sinh vào bằng mã thì đã có ExamCandidate.sessionId, nhưng học
  // viên ghi danh thì trước đây không có đường nào về ca.
  //
  // NULL = bài làm cũ có trước cột này → rơi về Exam.showResultsAfterSubmit.
  sessionId            String?
  // Frozen at start. For open_code mode, candidate types displayName in the
  // claim form. For assigned_code mode, instructor pre-fills it. Either way,
  // this snapshot is immutable after start — instructor edits the candidate
  // record, not this row, so prior attempts keep historic identity.
  candidateDisplayName String?
  status               ExamAttemptStatus @default(in_progress)
  startedAt            DateTime          @default(now())
  submittedAt          DateTime?
  gradedAt             DateTime?
  // Frozen at start — server uses startedAt + durationSec for timer (A7.4.3).
  durationSec          Int
  // Single-tab lock token (A7.4.7). Rotated when learner claims session from new tab.
  sessionToken         String            @unique @default(uuid())
  // Incremented every time learner resumes after disconnect (A7.4.5 analytics).
  resumeCount          Int               @default(0)
  // Deterministic shuffle seed snapshot — { questionOrder: [qid...], optionOrder: { qid: [optId...] } }
  shuffleSnapshot      Json?
  // Total points awarded (sum auto + manual). Null until any grading happens.
  score                Float?
  // 0-100, derived from score / totalPoints * 100.
  scorePct             Float?
  // NGỪNG GHI: xem Exam.passScore. Bài thi cũ vẫn giữ giá trị đã chấm.
  passed               Boolean?
  // A5.3.4 — Last heartbeat from the learner's browser. Updated by the
  // student heartbeat endpoint with write coalescing (≤ 1 UPDATE / 30s / attempt;
  // bus pubs sub-second). Used by the instructor live dashboard and the
  // heartbeat-lost detector cron (A5.3.6).
  lastHeartbeatAt      DateTime?

  exam             Exam                     @relation(fields: [examId], references: [id], onDelete: Cascade)
  user             User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidate        ExamCandidate?           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  // SetNull chứ không Cascade: xoá ca thi không được kéo bài làm đi theo —
  // bài làm là bằng chứng, mất là mất điểm của học sinh.
  session          ExamSession?             @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  answers          ExamAnswer[]
  incidents        ExamIncident[]
  messages         ExamMessage[]
  proctorSnapshots AttemptProctorSnapshot[]
  oralTurns        OralExamTurn[]
  oralEvaluation   OralExamEvaluation?
  // A6.7 — chủ đề hệ thống giao cho lượt vấn đáp này (null = đề không có chủ đề riêng,
  // cả lớp hỏi chung theo tài liệu). SetNull: xoá chủ đề không được kéo bài làm đi theo.
  oralTopicId      String?
  oralTopic        OralExamTopic?           @relation(fields: [oralTopicId], references: [id], onDelete: SetNull)

  // P0 single attempt per user per exam. Implemented as partial unique index
  // in raw SQL because Prisma doesn't model partial unique. See migration.
  @@index([examId, status])
  @@index([sessionId])
  @@index([oralTopicId])
  @@index([userId, submittedAt])
  // Hot index for autosubmit job (A7.5.2) — find in-progress attempts past deadline.
  @@index([status, startedAt])
  // Hot index for heartbeat-lost detector cron (A5.3.6).
  @@index([status, lastHeartbeatAt])
}

model ExamAnswer {
  id           String    @id @default(uuid())
  attemptId    String
  questionId   String
  // Shape per ExamQuestion.type — see config comment above.
  answerJson   Json?
  // Set by auto-grader (MCQ/MULTI/TF_NG/GAP_FILL). Null for ESSAY/SHORT (manual).
  autoScore    Float?
  // Set by instructor for ESSAY/SHORT, or override of autoScore on regrade.
  manualScore  Float?
  // True until autograder or instructor decides. Distinguishes pending essay
  // from auto-graded zero.
  needsGrading Boolean   @default(false)
  // Dedup key for idempotent autosave (A7.7.2). Hash of answerJson canonical form.
  answerHash   String?
  graderId     String?
  gradedAt     DateTime?
  comment      String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  attempt  ExamAttempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ExamQuestion       @relation(fields: [questionId], references: [id])
  grader   User?              @relation("ExamGrader", fields: [graderId], references: [id])
  history  ExamGradeHistory[]

  @@unique([attemptId, questionId])
  @@index([attemptId, needsGrading])
  @@index([questionId])
}

// Append-only regrade audit trail (A7.6.3).
model ExamGradeHistory {
  id          String   @id @default(uuid())
  answerId    String
  oldScore    Float?
  newScore    Float?
  reason      String?
  changedById String
  changedAt   DateTime @default(now())

  answer    ExamAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  changedBy User       @relation("ExamGradeChanger", fields: [changedById], references: [id])

  @@index([answerId, changedAt])
}

// Append-only incident log (A7.7.3 / A7.8). Reviewed by instructor — not auto-DQ.
model ExamIncident {
  id         String           @id @default(uuid())
  attemptId  String
  type       ExamIncidentType
  // Type-specific: { pastedLength }, { offlineSec }, { tabId }, ...
  payload    Json?
  occurredAt DateTime         @default(now())

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, occurredAt])
  @@index([type, occurredAt])
}

// A7.7.5 — Proctor webcam / screen snapshots captured during an attempt.
// The blob itself lives in the `private` storage layer (S3/R2 or disk); only
// the storageKey + metadata land here. `kind` distinguishes between scheduled
// periodic captures and event-triggered captures (e.g. on tab_blur). Reviewed-
// by lets instructors mark "I've looked at this" so unflagged frames don't get
// re-reviewed on every dashboard load.
enum ProctorSnapshotKind {
  periodic
  on_event
}

model AttemptProctorSnapshot {
  id           String              @id @default(uuid())
  attemptId    String
  kind         ProctorSnapshotKind
  storageKey   String // relative key inside `private/` layer
  mimeType     String              @default("image/jpeg")
  sizeBytes    Int
  capturedAt   DateTime            @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  reviewedBy User?       @relation("ProctorSnapshotReviewer", fields: [reviewedById], references: [id])

  @@index([attemptId, capturedAt])
}

// A5.3.5 — Live messages from instructor to student (1:1 or broadcast).
// Append-only for body/sender/timestamps. `readAt` is the only mutable field
// (state marker, not message content) and is set once when student client acks.
model ExamMessage {
  id         String    @id @default(uuid())
  examId     String
  // null = broadcast to every in-progress attempt of this exam.
  attemptId  String?
  fromUserId String
  body       String    @db.Text
  sentAt     DateTime  @default(now())
  readAt     DateTime?

  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  attempt ExamAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  from    User         @relation("ExamMessageSender", fields: [fromUserId], references: [id])

  @@index([attemptId, sentAt])
  @@index([examId, sentAt])
}

// A5.8 — Anonymous test-taker. Lives entirely in exam domain; never appears
// in User table (no email/password, can't log in elsewhere).
//
// `displayName` is immutable from the candidate's side: open_code candidates
// type it once at claim-time; assigned_code candidates have it pre-filled by
// instructor. Instructor may still rename post-exam — that emits an audit
// event `exam.candidate.renamed`.
model ExamCandidate {
  id          String    @id @default(uuid())
  examId      String
  // A5.3 PR1c.4 — Thí sinh thuộc về 1 ca thi (ExamSession). Required.
  // Cả assigned-code (createCandidate) lẫn open-code (claimOpenCode) đều tự
  // ensure session mặc định cho exam → no caller can omit this anymore.
  sessionId   String
  // A5.3 PR1a — optional link tới User account khi candidate đã có account
  // trên hệ thống (vd auto-link bằng email match). Vẫn cho null để giữ tương
  // thích với open_code/assigned_code anonymous flow hiện có.
  userId      String?
  displayName String
  // open_code: { phone (required Q1), email (required Q1), studentCode?, class? }
  // assigned_code: { studentCode?, class?, email?, phone?, ... } whatever
  //                 instructor provides. GDPR: export+delete API mandatory,
  //                 TTL 90 days after exam.closeAt.
  metadata    Json?
  // assigned_code mode: 8-10 ký tự alphanumeric, unique within exam. Null for
  // open_code candidates (they share Exam.openCode).
  accessCode  String?
  // P0 phòng thi — optional assignment to an ExamRoom. Null = not yet placed.
  // Set null on room delete (don't cascade-drop candidate).
  roomId      String?
  // PR2.12 — Cohort SV gõ mã ở form open-mode. Resolved server-side từ
  // (course.id, cohort.code). Null = chưa khai hoặc không thuộc cohort nào
  // (vd open test toàn trường, không cần phân lớp).
  cohortId    String?
  createdAt   DateTime  @default(now())
  // Instructor disable a candidate (assigned_code) before/after the exam.
  disabledAt  DateTime?
  // Q3 — when Send-codes email actually went out. Null = not yet sent.
  emailSentAt DateTime?
  // A5.3 PR2.8 — Proctor check-in attendance. Null = chưa điểm danh (default).
  // Set khi giám thị tick "có mặt" trên trang phòng. Đến muộn có thể infer
  // từ arrivedAt vs session.opensAt nếu cần phân tích sau.
  arrivedAt   DateTime?

  exam       Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  session    ExamSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  linkedUser User?           @relation("ExamCandidateUser", fields: [userId], references: [id], onDelete: SetNull)
  room       ExamRoom?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  cohort     CourseSection?  @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  attempts   ExamAttempt[]
  events     LearningEvent[]

  @@unique([examId, accessCode])
  @@index([examId])
  @@index([sessionId])
  @@index([userId])
  @@index([roomId])
  @@index([cohortId])
}

// =====================================================================
// P0 Phòng thi — group candidates into physical/virtual rooms with one
// proctor (giám thị) overseeing the live session and 0..N graders chấm
// essays of that room's candidates. Proctor and grader roles are disjoint
// per spec: monitor and chấm có thể khác người.
// =====================================================================
// PR2.18 — sourceRowNum: row number trong Excel khi bulk import. Null cho
// rows tạo thủ công.
model ExamRoom {
  id            String   @id @default(uuid())
  examId        String
  // A5.3 PR1c.3 — Phòng thi gắn với 1 ca thi (ExamSession). Required.
  // createExamRoom() auto-ensures 1 ExamSession mặc định cho legacy
  // exam-scoped callers.
  sessionId     String
  // A5.3 PR1c.3 — STT phòng (1-based) per ExamSession. Required.
  // Unique-per-session constraint sẽ siết ở PR1c.5.
  orderIndex    Int
  name          String
  // Single proctor — quy chế thi 1 phòng 1 giám thị. Required.
  proctorUserId String
  // Free-text địa điểm vật lý (vd "A101 — Nhà A1") hoặc link Zoom.
  locationNote  String?
  // PR2.18 — STT theo Excel khi bulk import. Cho phép GV sort + đối chiếu
  // với file gốc. Null cho rows tạo thủ công.
  sourceRowNum  Int?
  // Future: per-room IP allowlist. Empty = inherit exam-level rule.
  ipAllowlist   String[] @default([])
  // Mã phòng thi 4 ký tự cho thí sinh tự nhập khi join (mode open_code).
  // Sinh tự động khi tạo phòng. Nullable để rooms tạo trước feature này
  // không vỡ. Unique trong cùng 1 ExamSession.
  accessCode    String?  @db.VarChar(4)
  // Mã GIÁM THỊ — khác hoàn toàn accessCode ở trên. accessCode là mã phát cho
  // THÍ SINH (in lên phiếu, chiếu lên màn), nên không dùng làm cửa vào màn
  // giám sát được: cả phòng đã cầm nó trong tay.
  //
  // 8 ký tự thay vì 4, và unique TOÀN HỆ THỐNG chứ không chỉ trong một ca —
  // người nhập mã chưa biết mình thuộc ca nào, nên mã phải tự định vị được.
  proctorCode   String?  @unique @db.VarChar(8)
  // Phòng mặc định cho ca thi — thí sinh không nhập mã phòng sẽ auto-assign
  // vào đây. Partial unique index (chỉ 1 default/session) tạo trong migration.
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exam       Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  session    ExamSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  proctor    User             @relation("ExamRoomProctor", fields: [proctorUserId], references: [id])
  graders    ExamRoomGrader[]
  candidates ExamCandidate[]

  @@unique([examId, name])
  @@unique([sessionId, accessCode])
  @@index([examId])
  @@index([sessionId])
  @@index([proctorUserId])
}

model ExamRoomGrader {
  roomId    String
  userId    String
  createdAt DateTime @default(now())

  room ExamRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation("ExamRoomGrader", fields: [userId], references: [id])

  @@id([roomId, userId])
  @@index([userId])
}

// =====================================================================
// A5.2 — CourseSection + ExamSchedule (P1.5)
// CourseSection (Prisma model renamed từ Cohort — SQL table giữ tên "Cohort"
// qua @@map để zero migration risk, mirror pattern ExamSchedule→ExamSession).
// = "lớp học" (lớp K65A-DSAI-2025-2): administrative grouping, tách khỏi
// Course (nội dung dùng chung). Một course có nhiều section, mỗi section có
// invite link riêng (`inviteCode`) để học viên tự enroll.
//
// LƯU Ý QUAN TRỌNG: CohortMember (roster dùng cho exam-gating,
// assertEligibleForExam) và Enrollment.sectionId (roster dùng cho content
// access qua invite link) là 2 cơ chế TÁCH BIỆT trong vòng MVP invite-link
// này — một học viên có thể có mặt ở cái này mà không có ở cái kia. Không
// giả định chúng đồng bộ; hợp nhất là việc của round sau.
//
// ExamSchedule = per-section open/close window + optional duration override.
// =====================================================================
model CourseSection {
  id              String          @id @default(uuid())
  courseId        String
  name            String
  // PR2.12 — Mã lớp học do nhà trường định nghĩa (6-8 ký tự). SV gõ mã này
  // ở form open-mode để route kết quả về đúng section. Unique trong course.
  // KHÁC với inviteCode bên dưới (self-enroll, tự sinh, global-unique).
  code            String?
  // Invite-link self-enroll — mã tự sinh (crypto-secure), global-unique.
  // Null cho section mặc định (isDefault=true), section đó không cho join
  // qua link. Regenerate được — mã cũ mất hiệu lực ngay khi đổi.
  inviteCode      String?         @unique
  // true = section "mặc định" tự tạo cho mỗi course, dùng làm nơi rơi vào
  // cho enrollment không qua invite link (mua khoá học, bulk-import, data
  // cũ trước migration). Ẩn khỏi UI quản lý lớp học của GV.
  isDefault       Boolean         @default(false)
  // PR2.12 — GV phụ trách section (1 GV : N section). Null = chưa gán.
  instructorId    String?
  // Optional human description (e.g. "Lớp K65A-DSAI-2025-2 thứ 7 chiều")
  description     String?         @db.Text
  // B10 — điều kiện feedback áp cho học viên của lớp này. Ghi lên
  // FeedbackDelivery.generationContext lúc sinh, nên chuyển lớp giữa kỳ không
  // viết lại lịch sử.
  feedbackVariant FeedbackVariant @default(personalized)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor  User?             @relation("CohortInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  members     CohortMember[]
  schedules   ExamSession[]
  candidates  ExamCandidate[]
  examClasses CohortExamClass[]
  enrollments Enrollment[]

  @@unique([courseId, name])
  @@unique([courseId, code])
  @@index([courseId])
  @@index([instructorId])
  @@map("Cohort")
}

// PR2.15 — Mỗi cohort có 2-4 "mã lớp thi" (exam class) ứng với 1 phòng vật
// lý. Code unique trong course (không phải cohort). Cascade delete theo cohort.
model CohortExamClass {
  id                   String   @id @default(uuid())
  cohortId             String
  courseId             String
  code                 String
  roomLocation         String?
  // PR2.16 — Số SV dự kiến của lớp thi này, lấy từ Excel khi setup đợt.
  // Null = không khai. Dùng để audit (compare với số candidate thực tế).
  expectedStudentCount Int?
  createdAt            DateTime @default(now())

  cohort CourseSection @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  course Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, code])
  @@index([cohortId])
}

model CohortMember {
  cohortId String
  userId   String
  joinedAt DateTime @default(now())

  cohort CourseSection @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cohortId, userId])
  @@index([userId])
}

// A5.3 PR1c.1 — Renamed Prisma model `ExamSchedule` → `ExamSession`. SQL
// table name giữ nguyên qua @@map để zero migration risk. Service function
// names (`createExamSchedule`, `listExamSchedules`, ...) sẽ rename ở
// PR1c.2+ cùng với việc siết NOT NULL roundId và drop cohortId.
model ExamSession {
  id                  String                @id @default(uuid())
  examId              String
  // A5.3 PR1c.5 — ca thi thuộc về 1 đợt thi. Required. createExamSession()
  // tự ensure round mặc định cho legacy exam-scoped callers.
  roundId             String
  // A5.3 PR1a additive — mã ca thi nội bộ (vd "CA-1-SANG-14-05"). Unique trong round.
  // KHÔNG phải mã access cho SV — xem `openCode` bên dưới.
  code                String?
  // A5.3 PR1a additive — tên hiển thị (vd "Ca 1 — Sáng 14/5").
  title               String?
  // A5.3 PR1a additive — trạng thái lifecycle của ca.
  status              ExamSessionStatus     @default(draft)
  // PR2.12 — Access mode per-session (move xuống từ Exam). Mỗi ca có thể
  // khác mode (vd ca giấy = assigned_code, ca online = open_code).
  accessMode          ExamAccessMode        @default(authenticated)
  // PR2.12 — Mã access 6 ký tự khi accessMode = open_code. Mỗi ca 1 mã
  // riêng để giảm rủi ro rò rỉ. Null cho các mode khác.
  openCode            String?
  // A6.5 (rewrite) — mã THAM GIA riêng cho vấn đáp: SV đã đăng nhập tự nhập
  // mã này để vào thẳng ca, bỏ qua Enrollment (hợp với lớp mời ngoài, không
  // quản lý qua ghi danh). CỘT RIÊNG, không dùng chung `openCode` ở trên —
  // openCode là cho ExamCandidate ẩn danh của thi viết (đăng nhập không đồng
  // nghĩa đúng người, xem code-access.ts); gộp chung dễ khiến ca vấn đáp lỡ
  // đi qua nhánh claim-by-code của thi viết. Null khi ca chưa từng mở qua
  // đường mã tham gia (mọi ca vấn đáp trước bản rewrite này).
  oralJoinCode        String?               @unique
  // PR1a giữ cohortId để tương thích ngược (cohort không còn ràng buộc bắt
  // buộc theo spec mới, nhưng PR1a không drop). PR1c sẽ xoá.
  // null = applies to whole course (any enrolled learner).
  // set = restrict to candidates/users in this cohort.
  cohortId            String?
  opensAt             DateTime
  // NULL chỉ hợp lệ khi timingMode = manual (ca đóng bằng tay, không có hạn).
  // timingMode = scheduled thì bắt buộc có, validate ở tầng application.
  closesAt            DateTime?
  // Xem ExamSessionTimingMode. Mặc định `scheduled` để ca cũ giữ nguyên hành vi.
  timingMode          ExamSessionTimingMode @default(scheduled)
  // Xem ExamSessionScale. Mặc định `formal` cho ca CŨ vì chúng đều sinh ra từ
  // đường đợt/ca/phòng; ca tạo bằng "Phát link" ghi `simple` tường minh.
  scale               ExamSessionScale      @default(formal)
  // Ai bấm đóng ca thủ công gần nhất — phục vụ đối chiếu khi có khiếu nại.
  closedById          String?
  closedAt            DateTime?
  // Override Exam.durationMin for this cohort (e.g. extended-time accommodation).
  durationOverrideMin Int?
  // Ghi đè chính sách lộ đáp án của gói đề, cho RIÊNG ca này. NULL = theo gói
  // đề (Exam.showResultsAfterSubmit). Cùng khuôn với durationOverrideMin ngay
  // trên: cùng một gói đề mở được nhiều ca với chính sách khác nhau — ôn tập
  // thì hiện đáp án, thi thật thì không, mà không phải nhân bản gói đề.
  revealAnswers       ExamRevealPolicy?
  // Buổi thi này là đợt THỬ NGHIỆM câu hỏi hay bài thi thật. NULL = theo gói
  // đề (Exam.purpose).
  //
  // Nằm ở đây vì "thử nghiệm" là tính chất của LẦN TỔ CHỨC, không phải của
  // nội dung: cùng một gói đề hôm nay đem đo chất lượng câu hỏi, tuần sau
  // dùng thi thật. Trước đây nó chỉ có ở Exam, nên trang Thử nghiệm câu hỏi
  // lọc `purpose = field_test` và không thấy gói đề nào — mọi đường tạo gói
  // đề đều ghi cứng `assessment`.
  //
  // Exam.purpose VẪN GIỮ, nhưng mang nghĩa hẹp hơn: gói đề này có được phép
  // chứa câu hỏi chưa kết nạp vào ngân hàng không. Đó là tính chất của nội
  // dung, nên nó vẫn chặn chiều ngược lại (đề thử nghiệm không đem thi thật).
  purpose             ExamPurpose?
  // A5.8.6.5 Q2 — IP/CIDR allowlist to bypass open-mode rate-limit (labs).
  // Empty array = no allowlist; non-empty = only these IPs/CIDRs pass.
  ipAllowlist         String[]              @default([])
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  exam       Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  round      ExamRound       @relation(fields: [roundId], references: [id], onDelete: Restrict)
  cohort     CourseSection?  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  rooms      ExamRoom[]
  candidates ExamCandidate[]
  attempts   ExamAttempt[]

  @@unique([roundId, openCode])
  @@index([examId, opensAt])
  @@index([roundId, opensAt])
  @@index([cohortId])
  @@map("ExamSchedule")
}

// =====================================================================
// A5.3 — Đợt thi (ExamRound) + Ca thi (ExamSession) + Phòng thi (ExamRoom)
//
// Hierarchy: ExamRound → ExamSession (rename từ ExamSchedule ở PR1c)
//                     → ExamRoom → ExamCandidate
//
// PR1a (additive): tạo ExamRound + bridge tables; các quan hệ FK từ
// ExamSession/Room/Candidate sang Round/Session vẫn nullable. PR1b sẽ
// backfill rồi siết NOT NULL. PR1c sẽ drop cột examId cũ và rename Prisma
// model ExamSchedule → ExamSession (giữ tên bảng SQL qua @@map).
//
// ExamRound (PR2.11) — mỗi đợt thi gắn với 1 học phần duy nhất; thi song
// song nhiều môn = tạo nhiều đợt thi riêng. Admin (trưởng đợt) gán qua
// bridge ExamRoundAdmin để 1 đợt có nhiều admin.
// =====================================================================
enum ExamRoundStatus {
  draft
  open
  closed
  archived
}

enum ExamSessionStatus {
  draft
  open
  closed
  archived
}

/// Quy mô tổ chức của một lần thi. Trục NÀY tách khỏi ExamPurpose (đo học sinh
/// hay đo câu hỏi) — hai câu hỏi độc lập:
///   simple — một buổi, phát bằng link. Kiểm tra đầu giờ, khảo sát, thử nghiệm.
///   formal — nhiều ca, có phòng và giám thị. Thi cuối kỳ.
/// Nhồi hai trục vào một enum sẽ trộn "để làm gì" với "quy mô nào".
/// Khi nào học sinh được xem đáp án + điểm chi tiết của bài đã nộp.
///
/// Bốn nấc vì nghề dạy thật có bốn tình huống, không phải hai:
///   immediately  — ôn tập, kiểm tra nhanh, chữa ngay tại lớp.
///   never        — thử nghiệm câu hỏi; lộ đáp án là đốt câu hỏi.
///   after_close  — thi thật, nhưng vẫn muốn học sinh học lại từ đề sau khi
///                  cả ca đã nộp xong. Nếu chỉ có hai nấc thì nhóm này buộc
///                  phải chọn `never` rồi cuối buổi vào sửa tay.
///   score_only   — điểm danh, khảo sát nhanh: cho biết điểm cuối cùng ngay,
///                  nhưng KHÔNG hiện câu nào đúng/sai hay đáp án. Không đốt
///                  câu hỏi như `immediately`, mà cũng không im lặng hoàn
///                  toàn như `never`.
enum ExamRevealPolicy {
  immediately
  never
  after_close
  score_only
}

enum ExamSessionScale {
  simple
  formal
}

/// Cách một ca thi xác định "đang mở":
///   scheduled — theo cửa sổ opensAt/closesAt (hành vi cũ, mặc định).
///   manual    — GV bấm mở/đóng; `status` là nguồn sự thật, closesAt = null.
/// Thêm mới là additive: mọi ca cũ giữ nguyên `scheduled` nên không đổi hành vi.
enum ExamSessionTimingMode {
  scheduled
  manual
}

model ExamRound {
  id          String          @id @default(uuid())
  // A5.3 PR2.11 — Mỗi đợt thi gắn với 1 học phần. Trước đây cross-course
  // qua bridge ExamRoundCourse; rollback để đơn giản hoá: tổ chức thi
  // song song nhiều môn = tạo nhiều đợt thi riêng.
  // A7.x — nullable: đợt tự sinh (ensureDefaultRound) cho đề không gắn khoá
  // học (đề độc lập) không có course nào để gắn — xem Exam.courseId.
  courseId    String?
  // Code unique trong phạm vi course (vd "FINAL-HK1-2026") — không cần
  // global unique sau khi rollback cross-course.
  code        String
  title       String
  description String?         @db.Text
  opensAt     DateTime
  closesAt    DateTime
  status      ExamRoundStatus @default(draft)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  course   Course?          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  admins   ExamRoundAdmin[]
  sessions ExamSession[]

  @@unique([courseId, code])
  @@index([courseId, opensAt])
  @@index([opensAt])
  @@index([status, opensAt])
}

model ExamRoundAdmin {
  roundId   String
  userId    String
  grantedAt DateTime @default(now())
  grantedBy String?

  round   ExamRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  grantor User?     @relation("ExamRoundAdminGrantor", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@id([roundId, userId])
  @@index([userId])
}

// =====================================================================
// A5.2.4 — Exam Sections + Random Pool (P2)
// Each Exam decomposes into ≥ 1 sections. fixed = explicit question list;
// random_from_bank = sampler draws N questions from a filtered bank pool.
// resolutionMode controls when the random sample is frozen:
//   per_attempt  — sampler runs at startExamAttempt (each SV gets own set)
//   per_publish  — sampler runs once at publish, all SV see same shuffled set
// Backfill: existing exams get 1 default section "Main" (selectionMode=fixed)
// owning all current questions.
// =====================================================================
enum ExamSectionSelectionMode {
  fixed
  random_from_bank
}

enum ExamSectionResolutionMode {
  per_attempt
  per_publish
}

model ExamSection {
  id                      String                    @id @default(uuid())
  examId                  String
  title                   String
  orderIndex              Int
  selectionMode           ExamSectionSelectionMode  @default(fixed)
  resolutionMode          ExamSectionResolutionMode @default(per_attempt)
  // random_from_bank pool filter: { bankIds, skillIds, difficulty[], type[], count, pointsPerItem }
  poolFilter              Json?
  // resolutionMode=per_publish only: snapshot of question IDs picked once.
  materializedQuestionIds Json?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  exam  Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  items ExamSectionItem[]

  @@unique([examId, orderIndex])
  @@index([examId])
}

model ExamSectionItem {
  sectionId      String
  // 1:1 with ExamQuestion — each question belongs to exactly one section.
  examQuestionId String
  orderInSection Int
  // Override section-default points if set (else inherit ExamQuestion.points).
  points         Int

  section  ExamSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)

  @@id([sectionId, examQuestionId])
  @@unique([examQuestionId])
  @@index([sectionId, orderInSection])
}

// =====================================================================
// A5.1 — Question Bank (P1)
// Reusable question pool, scoped private/course (org reserved for multi-tenant).
// Each BankQuestion can be copied into many ExamQuestions; the snapshot is
// frozen via BankQuestionVersion so future bank edits don't break exam history.
// =====================================================================

enum QuestionBankVisibility {
  private
  course
  org // reserved — multi-tenant phase
}

enum BankQuestionStatus {
  draft
  published
  archived
}

// A5.5 — Mức tư duy Bloom gộp 3 nhóm cho Cơ bản mode. Nâng cao mode (sau)
// có thể bổ sung enum 6-bậc song song nếu cần.
//   remember_understand = Bloom 1+2 (Nhớ & Hiểu)
//   apply               = Bloom 3   (Vận dụng)
//   analyze_plus        = Bloom 4+5+6 (Phân tích / Đánh giá / Sáng tạo)
enum CognitiveLevel {
  remember_understand
  apply
  analyze_plus
}

model QuestionBank {
  id          String                 @id @default(uuid())
  ownerUserId String
  // null = private to owner. Set = visible to instructors of the course.
  courseId    String?
  name        String
  description String?                @db.Text
  visibility  QuestionBankVisibility @default(private)
  // Prefix để auto-sinh BankQuestion.code (vd "KNM" → KNM-0001). Null = không
  // auto-sinh, instructor có thể tự nhập code tay.
  codePrefix  String?
  // Sequence next dùng cho auto-sinh code. Atomic increment trong transaction.
  codeNextSeq Int                    @default(1)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  owner     User           @relation("QuestionBankOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  course    Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions BankQuestion[]

  @@index([ownerUserId])
  @@index([courseId])
}

model BankQuestion {
  id               String             @id @default(uuid())
  bankId           String
  // Mã human-readable (vd "KNM-0001"). Unique per bank khi không null.
  // Auto-sinh từ QuestionBank.codePrefix + codeNextSeq khi tạo mới (nếu bank
  // có codePrefix). Instructor có thể đổi tay qua UI.
  code             String?
  type             ExamQuestionType
  prompt           String             @db.Text
  // Same shape as ExamQuestion.config — see ExamQuestion comment.
  config           Json
  points           Int                @default(1)
  // 1–5, app-validated. 1 = trivial, 3 = average, 5 = very hard.
  difficulty       Int                @default(3)
  // A5.5 — Mức tư duy Bloom gộp. Backfill heuristic theo difficulty (1-2 →
  // remember_understand, 3 → apply, 4-5 → analyze_plus). GV chỉnh tay sau.
  cognitiveLevel   CognitiveLevel     @default(remember_understand)
  estimatedTimeSec Int?
  status           BankQuestionStatus @default(draft)
  // A5.6 — Exposure tracking: incremented each time the question is sampled
  // for a per_attempt random section. Helps instructors spot overused items.
  exposureCount    Int                @default(0)
  lastSampledAt    DateTime?
  // ── Siêu dữ liệu quản lý ngân hàng (instructor metadata) ────────────────
  // CĐR (chuẩn đầu ra) — free-text, độc lập với skillTags. Có thể nhập kiểu
  // "Sinh viên giải thích được khái niệm vòng tròn ảnh hưởng".
  learningOutcome  String?            @db.Text
  // Tác giả ghi tự do. Default = tên creator khi tạo mới câu hỏi (xem
  // createBankQuestion). Cho phép tên GV ngoài hệ (vd "Cô Lan").
  authorName       String?
  // Trạng thái thẩm định nội dung: pending | approved | needs_revision.
  // Khác với `status` (draft/published/archived) là vòng đời xuất bản — câu
  // có thể `published` nhưng vẫn `pending` thẩm định nếu workflow tách 2 vai.
  reviewStatus     String             @default("pending")
  reviewedByUserId String?
  reviewedAt       DateTime?
  // Ghi chú sửa: free-text changelog. UI bank workbench hiển thị ở EditTab.
  editNote         String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  bank       QuestionBank           @relation(fields: [bankId], references: [id], onDelete: Cascade)
  reviewedBy User?                  @relation("BankQuestionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  skillTags  BankQuestionSkillTag[]
  versions   BankQuestionVersion[]
  copiedTo   ExamQuestionFromBank[]
  stats      BankQuestionStats?
  trialStats ItemTrialStat[]

  @@unique([bankId, code], map: "BankQuestion_bankId_code_key")
  @@index([bankId, status])
  @@index([bankId, reviewStatus])
  @@index([difficulty])
  // A5.5 — pool query của wizard assemble lọc theo (bank, mức tư duy, độ khó).
  @@index([bankId, cognitiveLevel, difficulty])
}

model BankQuestionSkillTag {
  bankQuestionId String
  skillId        String
  weight         Float  @default(1.0)

  bankQuestion BankQuestion @relation(fields: [bankQuestionId], references: [id], onDelete: Cascade)
  skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([bankQuestionId, skillId])
  @@index([skillId])
}

// Immutable snapshot — written each time a published BankQuestion is edited.
// ExamQuestionFromBank links the exam-side copy to a specific version, so a
// later bank edit never mutates an exam that's already in use.
model BankQuestionVersion {
  id             String   @id @default(uuid())
  bankQuestionId String
  versionNumber  Int
  prompt         String   @db.Text
  config         Json
  points         Int
  createdAt      DateTime @default(now())

  bankQuestion BankQuestion           @relation(fields: [bankQuestionId], references: [id], onDelete: Cascade)
  copiedTo     ExamQuestionFromBank[]
  trialStats   ItemTrialStat[]

  @@unique([bankQuestionId, versionNumber])
}

model ExamQuestionFromBank {
  // 1:1 with ExamQuestion — when exam copies a bank question, this row links
  // back to the source (and the frozen version).
  examQuestionId        String   @id
  bankQuestionId        String
  bankQuestionVersionId String
  copiedAt              DateTime @default(now())

  examQuestion ExamQuestion        @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)
  bankQuestion BankQuestion        @relation(fields: [bankQuestionId], references: [id])
  version      BankQuestionVersion @relation(fields: [bankQuestionVersionId], references: [id])

  @@index([bankQuestionId])
}

// =====================================================================
// A5.4 — Item Analytics (P2.5)
// Materialized stats rebuilt nightly by cron `exam-analytics`. Computed from
// ExamAnswer + ExamAttempt: p-value (correct / attempted), discrimination
// (point-biserial correlation between item correctness and total score),
// distractor analysis (MCQ option choice distribution).
// =====================================================================
model ExamQuestionStats {
  // 1:1 with ExamQuestion. PK = examQuestionId so upsert by id.
  examQuestionId  String   @id
  // Submitted attempts that answered this question (denominator).
  attemptCount    Int      @default(0)
  // Attempts where awarded == max points (numerator).
  correctCount    Int      @default(0)
  // p-value = correctCount / attemptCount. 0 = too hard, 1 = too easy.
  // Sentinel -1 when attemptCount < 5 (statistically meaningless).
  pValue          Float    @default(-1)
  // Point-biserial correlation between item correctness and total score on
  // the exam. Sentinel -2 when not enough data. Healthy range: > 0.2.
  discrimination  Float    @default(-2)
  // Mean time spent (sec) on this question. Null if no time tracking.
  avgTimeSec      Float?
  // For MCQ/multi: { optionId: { chosenBy: count, isCorrect: bool } }
  distractorStats Json?
  computedAt      DateTime @default(now())

  examQuestion ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)
}

/// Một quan sát cho MỖI lần một phiên bản câu hỏi được đem ra dùng trong một
/// đợt. CHỈ GHI THÊM — không bao giờ UPDATE/DELETE, giống LearningEvent.
///
/// Vì sao cần bảng riêng: `ExamQuestionStats` bị cron ghi đè mỗi đêm (chỉ giữ
/// ảnh chụp hiện tại) còn `BankQuestionStats` là trung bình có trọng số gộp mọi
/// phiên bản. Cả hai đều xoá mất chuỗi số liệu theo thời gian — đúng thứ mà
/// việc thử nghiệm câu hỏi cần giữ.
///
/// Khoá theo (phiên bản câu × đề × đợt) chứ không theo câu: cộng dồn lẫn bản
/// trước và sau khi sửa câu chữ là vô nghĩa.
model ItemTrialStat {
  // Khoá là câu-trong-đề, không phải (câu × đợt): computeExamAnalytics() gộp
  // mọi lượt làm theo ĐỀ chứ không tách theo đợt, nên tách theo đợt ở đây chỉ
  // là giả vờ có độ phân giải mà tầng tính toán không có.
  //
  // Vẫn đủ để dựng chuỗi lịch sử: mỗi lần đem một câu đi thử là một đề khác,
  // nên sinh ra một ExamQuestion khác, tức một quan sát khác.
  examQuestionId        String  @id
  // Câu trong ngân hàng + ĐÚNG phiên bản câu chữ đã đem ra thử.
  bankQuestionId        String
  bankQuestionVersionId String
  // Đề nào chở câu này, và câu đó trong đề là row nào.
  examId                String
  // Đợt thi (ExamRound) — metadata để nhóm và hiển thị, không tham gia khoá.
  // Null khi đề chưa gắn ca nào.
  roundId               String?
  // Nhãn tự đặt cho lần thử — để nhóm các đề rời thành một đợt thử nghiệm
  // logic khi ExamRound không phải đơn vị đúng.
  trialLabel            String?

  // Cùng bộ chỉ số với ExamQuestionStats, chốt tại thời điểm ghi.
  attemptCount    Int
  correctCount    Int
  pValue          Float
  discrimination  Float
  avgTimeSec      Float?
  distractorStats Json?
  // Thời điểm chốt số liệu, KHÔNG phải thời điểm thi.
  computedAt      DateTime @default(now())

  bankQuestion BankQuestion        @relation(fields: [bankQuestionId], references: [id], onDelete: Cascade)
  version      BankQuestionVersion @relation(fields: [bankQuestionVersionId], references: [id])

  @@index([bankQuestionId, computedAt])
  @@index([bankQuestionVersionId])
  @@index([examId])
}

model BankQuestionStats {
  bankQuestionId    String   @id
  // Number of ExamQuestionFromBank rows referencing this bank question.
  totalUses         Int      @default(0)
  // Aggregate attempts across all uses.
  totalAttempts     Int      @default(0)
  // Average p-value across all uses (weighted by attemptCount).
  pValueAvg         Float    @default(-1)
  // Average discrimination across all uses.
  discriminationAvg Float    @default(-2)
  computedAt        DateTime @default(now())

  bankQuestion BankQuestion @relation(fields: [bankQuestionId], references: [id], onDelete: Cascade)
}

// =====================================================================
// System — Release log (ghi bởi deploy workflow, đọc bởi admin UI)
// Append-only: không bao giờ UPDATE/DELETE.
// =====================================================================
model SystemRelease {
  id         String   @id @default(uuid())
  // Tag git tương ứng, vd: "deploy-c704542"
  tag        String   @unique
  // 7-char git SHA
  sha        String
  // Markdown body của release (phân loại theo conventional commits)
  body       String   @db.Text
  // Thời điểm deploy hoàn thành (UTC, ghi bởi deploy script)
  deployedAt DateTime
  createdAt  DateTime @default(now())

  @@index([deployedAt])
}

// =====================================================================
// PR2.17 — Multi-tenancy: Organization (= trường).
//
// Mỗi User/Course thuộc về 1 Organization. Cross-org access bị chặn ở
// service layer (trừ Platform Admin — role "admin" — bypass).
// OrganizationAdmin bridge: 1 user có thể là OrgAdmin của nhiều org (rare
// in practice, nhưng giữ flexibility).
// =====================================================================
model Organization {
  id              String   @id @default(uuid())
  // Mã trường ngắn (vd "BKHN"), unique, dùng làm slug.
  code            String   @unique
  name            String
  locale          String   @default("vi")
  timezone        String   @default("Asia/Ho_Chi_Minh")
  brandingLogoUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users            User[]
  courses          Course[]
  admins           OrganizationAdmin[]
  sessionTemplates ExamSessionTemplate[]
  emailTemplates   EmailTemplate[]
  emailBatches     EmailDispatchBatch[]

  @@index([code])
}

model OrganizationAdmin {
  organizationId  String
  userId          String
  grantedAt       DateTime @default(now())
  grantedByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
}

// =====================================================================
// Email Templates — admin-editable transactional email templates.
// Loaded by sendTemplatedEmail() at runtime; falls back to hard-coded
// defaults if a key is missing or `enabled=false`. Revisions table keeps
// edit history for rollback.
// =====================================================================
model EmailTemplate {
  id              String   @id @default(uuid())
  // Multi-tenancy: null = global default; non-null = per-org override.
  organizationId  String?
  key             String
  name            String
  description     String?  @db.Text
  category        String
  subject         String   @db.Text
  bodyHtml        String   @db.Text
  bodyText        String?  @db.Text
  variables       Json
  enabled         Boolean  @default(true)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy    User?                   @relation("EmailTemplateEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  revisions    EmailTemplateRevision[]

  @@unique([organizationId, key])
  @@index([category])
  @@index([key])
}

model EmailTemplateRevision {
  id             String   @id @default(uuid())
  templateId     String
  subject        String   @db.Text
  bodyHtml       String   @db.Text
  bodyText       String?  @db.Text
  editedByUserId String
  editedAt       DateTime @default(now())

  template EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  editedBy User          @relation("EmailTemplateReviser", fields: [editedByUserId], references: [id])

  @@index([templateId, editedAt])
}

// PR2.17 — Catalog ca thi cho mỗi trường. Org admin maintain.
// Khi tạo ExamRound mới: GV pick 1 hoặc nhiều template + chọn ngày →
// service auto sinh ExamSession instances với opensAt/closesAt được ghép
// từ (round date + template startTime/endTime).
model ExamSessionTemplate {
  id             String   @id @default(uuid())
  organizationId String
  code           String // "CA-1", "CA-2"...
  name           String // "Ca 1 — Sáng"
  // Local time of day in HH:MM format. Combined with round's date at apply time.
  startTime      String // "07:30"
  endTime        String // "09:30"
  // Display ordering trong picker.
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, orderIndex])
}

// =====================================================================
// Email Dispatch — review-before-send queue for bulk emails.
//
// Instead of fire-and-forget, the responsible user (instructor, round
// admin) creates a Batch, reviews each Item (recipient + variables),
// can untick people who shouldn't receive, then approves the batch to
// trigger actual sending. Each Item is sent once and records its
// outcome for resend-on-failure.
//
// First use case: exam.access_code (gửi mã dự thi). Generic enough to
// later cover proctor-bulk-invite, grade-published, deadline-reminder.
// =====================================================================

enum EmailDispatchStatus {
  // Pending review. Items selected/deselected; not yet sent.
  draft
  // User clicked "Send"; items being processed.
  sending
  // All items processed (sent or failed). Resend allowed for failed.
  completed
  // User cancelled before sending.
  cancelled
}

enum EmailDispatchItemStatus {
  pending
  // Successfully sent (provider accepted).
  sent
  // Provider returned an error or threw.
  failed
  // User unticked this row before approving — never attempted.
  skipped
}

model EmailDispatchBatch {
  id             String              @id @default(uuid())
  // Owning org — drives per-tenant template lookup at send time and
  // limits visibility (org admins only see their own batches).
  organizationId String?
  // Stable template key (e.g. "exam.access_code"). Renders use the
  // normal org→global→fallback lookup.
  templateKey    String
  // Polymorphic link to the "thing" this batch is about. e.g.
  // targetType="exam", targetId=<examId>. Lets the review UI link
  // back without a hard FK to every possible owner table.
  targetType     String
  targetId       String
  // Human-readable title shown in history list, e.g.
  // "Gửi mã dự thi — Kỳ thi cuối kỳ K65".
  title          String
  // Free-form notes the creator adds for context.
  description    String?             @db.Text
  status         EmailDispatchStatus @default(draft)
  totalItems     Int                 @default(0)
  sentCount      Int                 @default(0)
  failedCount    Int                 @default(0)
  skippedCount   Int                 @default(0)

  createdByUserId  String
  // Who clicked the "Approve & send" button. May equal createdByUserId
  // when single-eye approval, or differ when two-eye flow added later.
  approvedByUserId String?
  approvedAt       DateTime?
  // Set when status flips to "completed" (all items processed).
  completedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy    User                @relation("EmailBatchCreator", fields: [createdByUserId], references: [id])
  approvedBy   User?               @relation("EmailBatchApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  items        EmailDispatchItem[]

  @@index([organizationId, createdAt])
  @@index([targetType, targetId])
  @@index([createdByUserId, createdAt])
  @@index([status])
}

model EmailDispatchItem {
  id             String  @id @default(uuid())
  batchId        String
  // Recipient address — required, must be valid by the time batch is approved.
  recipientEmail String
  recipientName  String
  // Resolved Handlebars variables for THIS recipient. Frozen at batch
  // creation so reviewers see exactly what will be sent.
  variables      Json
  // Polymorphic back-link to the originating row (e.g. examCandidateId).
  // Lets the UI mark the source as "đã gửi" after send.
  sourceType     String?
  sourceId       String?

  // User toggles this in the review UI. Unticked rows are marked
  // skipped (not pending) when batch is approved.
  selected Boolean @default(true)

  status        EmailDispatchItemStatus @default(pending)
  errorMessage  String?
  // Resend hooks: bumped each time we attempt this item.
  attemptCount  Int                     @default(0)
  lastAttemptAt DateTime?
  sentAt        DateTime?
  // Provider message ID (Resend returns this) for traceability.
  providerId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch EmailDispatchBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, status])
  @@index([sourceType, sourceId])
}

// ── Limio-Live (module 4 — bài giảng tương tác kiểu Nearpod) ────────────────
// Đợt 1: data model + soạn bài giảng (deck độc lập, thuộc về giáo viên, giống
// TeachingActivityPlan — KHÔNG gắn Course/Lesson).
// Đợt 2: runtime trình chiếu (LiveSession) — liên kết ClassroomPoll/WordCloud/
// InteractiveBoard lúc trình chiếu, tái dùng nguyên hạ tầng QR/join/SSE của
// các công cụ đó thay vì xây lại.

// Cách học viên vào phiên trình chiếu qua mã tham gia cấp phiên: ẩn danh (mặc định, chỉ cần
// quét QR) hoặc bắt buộc đăng nhập tài khoản Limio (mỗi tài khoản 1 phiếu/câu).
enum LiveIdentityMode {
  anonymous
  login
}

enum LiveSlideType {
  content
  quiz
  poll
  word_cloud
  collaborate_board
  // Bảng trắng vẽ chung: cả lớp cùng vẽ lên 1 khung Excalidraw (model Whiteboard), khác Draw-it (mỗi người 1 hình).
  whiteboard
}

model LiveDeck {
  id        String   @id @default(uuid())
  userId    String
  title     String
  // Giao diện slide cho cả bài giảng — id trong limio-live/slideThemes.ts.
  theme     String   @default("white")
  // Nhóm chứa bài giảng (tuỳ chọn, tối đa 1 nhóm). Xoá nhóm thì bài giảng chỉ
  // mất nhóm, không mất bài.
  groupId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    LiveDeckGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  slides   LiveSlide[]
  sessions LiveSession[]

  @@index([userId])
  @@index([groupId])
}

enum LiveDeckGroupKind {
  course
  event
  other
}

// Nhóm bài giảng của một giảng viên — gom nhiều LiveDeck theo khoá học/sự kiện.
// `courseId` liên kết TUỲ CHỌN với một khoá LMS thật; xoá khoá chỉ mất liên kết
// (nhóm và bài giảng còn nguyên).
model LiveDeckGroup {
  id        String            @id @default(uuid())
  userId    String
  name      String
  kind      LiveDeckGroupKind @default(other)
  courseId  String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  decks  LiveDeck[]

  @@index([userId])
  @@index([courseId])
}

// orderIndex ở đây LÀ thứ tự trình chiếu thật (khác TeachingActivityPlanItem
// — Limio-Live tuần tự, không "chạy tuỳ ý"). config theo từng loại:
//   content: { title, subtitle, bullets: string[], imageUrl? }
//   quiz: { question, options: [{ text, correct }] }
//   poll: { question, options: [{ text }] }
//   word_cloud: { prompt }
//   collaborate_board: { prompt, mode: "free"|"grouped", columns?: string[],
//                        allowViewOthers?: boolean, blockPaste?: boolean }
// timerSeconds: đồng hồ tuỳ chọn, giáo viên tự bấm Bắt đầu lúc trình chiếu —
// không tự chạy, không tự khoá gì khi hết giờ (xem acceptance criteria P0).
model LiveSlide {
  id           String        @id @default(uuid())
  deckId       String
  type         LiveSlideType
  config       Json
  timerSeconds Int?
  orderIndex   Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  deck LiveDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([deckId, orderIndex])
}

// Một lượt trình chiếu (Present) của 1 LiveDeck. GV bấm "Trình chiếu" sẽ
// resume phiên đang mở (endedAt=null) của chính họ nếu có — tránh mất kết quả
// khi lỡ refresh trang; muốn làm lại từ đầu (lớp khác/buổi khác) thì phải
// "Kết thúc" phiên cũ trước, vì mỗi lượt trình chiếu là 1 buổi độc lập, không
// cộng dồn kết quả giữa các buổi.
model LiveSession {
  id     String @id @default(cuid())
  deckId String
  userId String

  // ClassroomPoll/WordCloud cần sessionId — tạo lười (lazy) lúc slide tương
  // tác đầu tiên của LƯỢT NÀY cần tới, dùng chung cho mọi slide poll/quiz/
  // word_cloud trong cùng lượt trình chiếu.
  classroomSessionId String?

  // Map slideId -> id bản ghi runtime (ClassroomPoll cho quiz/poll, WordCloud,
  // hoặc InteractiveBoard) — polymorphic theo LiveSlide.type, không có FK cứng
  // vì có thể trỏ tới 1 trong 3 bảng khác nhau tuỳ loại slide (xem
  // EmailDispatchBatch.targetType/targetId cho tiền lệ tương tự trong schema
  // này). Content slide không cần entry.
  slideRuntimeRefs Json @default("{}")

  currentSlideId String?

  // Mã tham gia CẤP PHIÊN (6 ký tự): học viên quét 1 QR /learn/live/{joinCode} rồi tự động
  // theo slide tương tác giảng viên đang chiếu, không phải quét lại cho từng câu hỏi.
  joinCode     String?          @unique
  identityMode LiveIdentityMode @default(anonymous)

  // Trạng thái UI cần đồng bộ giữa cửa sổ người trình bày và cửa sổ chiếu lên
  // màn hình (2 cửa sổ riêng — xem PresentDeck.tsx) — vd đồng hồ đếm giờ đã
  // bấm Bắt đầu chưa (timerStartedAt: { [slideId]: epoch ms }), câu hỏi đã
  // "Đóng" để lộ đáp án đúng chưa (revealed: { [slideId]: boolean }). Gộp 1
  // JSON thay vì thêm cột riêng cho từng cờ — đều là cờ tạm thời của 1 lượt
  // trình chiếu, không cần query riêng.
  uiState Json @default("{}")

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  deck             LiveDeck          @relation(fields: [deckId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  classroomSession ClassroomSession? @relation(fields: [classroomSessionId], references: [id], onDelete: SetNull)

  @@index([deckId, userId, endedAt])
  @@index([userId])
}
