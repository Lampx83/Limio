{
  "name": "@feedbackme/core-feedback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backfill:feedback-coding": "node --env-file=../db/.env --import tsx scripts/backfill-feedback-coding.ts",
    "propose:misconceptions": "node --env-file=../db/.env --import tsx scripts/propose-misconceptions.ts",
    "apply:misconceptions": "node --env-file=../db/.env --import tsx scripts/apply-misconceptions.ts"
  },
  "dependencies": {
