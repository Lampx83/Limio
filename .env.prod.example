# =========================================================================
# FeedBackMe — production env (dùng với docker-compose.prod.yml)
# Copy file này -> .env.prod, đặt trên server, nhớ chmod 600.
# =========================================================================

# ----- Bắt buộc -----
POSTGRES_PASSWORD=change-me-strong-random
# Nếu serve từ root: NEXTAUTH_URL=https://your-domain.example.com
# Nếu serve từ sub-path /limio: NEXTAUTH_URL=https://your-domain.example.com/limio
NEXTAUTH_URL=https://your-domain.example.com
# Sub-path prefix (để trống nếu serve từ root, điền /limio nếu proxy sub-path)
NEXT_PUBLIC_BASE_PATH=
# NextAuth v5 dùng AUTH_SECRET; compose map NEXTAUTH_SECRET -> AUTH_SECRET tự động.
# Dùng: openssl rand -base64 32
NEXTAUTH_SECRET=generate-via-openssl-rand-base64-32
CRON_SECRET=generate-via-openssl-rand-hex-32

# ----- Tùy chọn -----
# Image tag — CI sẽ override bằng git SHA khi deploy.
IMAGE_TAG=latest

# Cổng public của web (reverse proxy trỏ vào đây). Production = 8004.
WEB_PORT=8004

# Timezone cho cron sidecar.
TZ=Asia/Ho_Chi_Minh

# ----- OAuth / API keys -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
SENTRY_DSN=
