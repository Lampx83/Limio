# =========================================================================
# FeedBackMe — production env (dùng với docker-compose.prod.yml)
# Copy file này -> .env.prod, đặt trên server, nhớ chmod 600.
# =========================================================================

# ----- Bắt buộc -----
POSTGRES_PASSWORD=change-me-strong-random
# Production deploy ở root domain limio.vn
NEXTAUTH_URL=https://limio.vn

# Origin công khai cho SEO (canonical, sitemap.xml, robots.txt, ảnh OG).
# Bỏ trống thì lấy NEXTAUTH_URL — chỉ set khi hai domain khác nhau.
SITE_URL=
# Sub-path prefix — để trống vì serve từ root domain.
# (Nếu sau này proxy sub-path, ví dụ domain.com/foo, thì điền /foo và rebuild image.)
NEXT_PUBLIC_BASE_PATH=
# NextAuth v5 dùng AUTH_SECRET; compose map NEXTAUTH_SECRET -> AUTH_SECRET tự động.
# Dùng: openssl rand -base64 32
NEXTAUTH_SECRET=generate-via-openssl-rand-base64-32
CRON_SECRET=generate-via-openssl-rand-hex-32
# Password cho các tài khoản Admin do seed script tạo — admin@feedbackme.dev
# (seed-demo-users.ts, chạy tự động mỗi lần deploy) và admin@demo-english.limio.vn
# (seed-demo-english-center.ts, chạy thủ công nếu có demo profile đó). Repo
# public nên KHÔNG được để trống hoặc dùng giá trị cũ (password1234/demo1234):
# script sẽ fail nếu thiếu biến này khi NODE_ENV=production.
# Dùng: openssl rand -base64 24
DEMO_ADMIN_PASSWORD=generate-via-openssl-rand-base64-24
# Mã hoá IntegrationCredential (OpenAI API key, v.v.) trong DB.
# Dùng: openssl rand -hex 32  (đúng 64 ký tự hex = 32 byte)
# CẢNH BÁO: Không đổi sau khi đã lưu credential — đổi = mọi key đã lưu hỏng (decrypt_failed). Backup cùng DB.
SECRETS_MASTER_KEY=generate-via-openssl-rand-hex-32

# ----- Tùy chọn -----
# Image tag — CI sẽ override bằng git SHA khi deploy.
IMAGE_TAG=latest

# Cổng public của web (reverse proxy ngoài host trỏ vào đây). Production = 8004.
# Tintin: cổng này giờ là Caddy LB (web-proxy service) đứng trước N web replicas.
WEB_PORT=8004

# Tintin — số web replica chạy sau Caddy LB. Default 3 cho 5K SV thi đồng thời.
# Tăng nếu thi đợt lớn hơn; giảm về 1 cho dev/staging.
WEB_REPLICAS=3

# Tintin — BullMQ auto-grade worker concurrency. Mỗi job ~50-200ms tuỳ số câu.
# Default 10 tránh exhaust PgBouncer pool (50 backend conn).
AUTO_GRADE_CONCURRENCY=10

# Timezone cho cron sidecar.
TZ=Asia/Ho_Chi_Minh

# ----- File storage (D.1) -----
# Bỏ trống cả khối này → mặc định lưu local disk tại apps/web/uploads/ trong
# volume Docker `web-uploads` (CHUNG Ổ VẬT LÝ với volume postgres-data trên
# server 224 — đầy 1 cái là cả web lẫn DB đều ghi lỗi). Set S3_BUCKET (R2/S3/
# bất kỳ dịch vụ S3-compatible nào) để chuyển hẳn ra ngoài, xem lib/storage.ts.
#
# Trước khi set các biến này trong .env.prod THẬT: chạy
#   tsx apps/web/scripts/verify-s3-storage.ts
# với cùng giá trị (qua biến môi trường tạm) để chắc chắn bucket/credentials
# đúng, rồi mới migrate dữ liệu cũ bằng
#   tsx apps/web/scripts/migrate-uploads-to-s3.ts --apply
# trước khi restart web/worker/cron với S3 bật — nếu không file cũ (avatar,
# video bài giảng, bài nộp...) sẽ "biến mất" vì app đọc trên S3 còn dữ liệu
# vẫn nằm ở local disk.
S3_BUCKET=
# Bucket riêng cho layer "public" (avatar, video/ảnh/pdf bài học...) — để bật
# CDN/anonymous-read mà không public luôn bài nộp của học viên. Bỏ trống thì
# layer "public" dùng chung S3_BUCKET với prefix "public/".
S3_BUCKET_PUBLIC=
# Bucket cho layer "private" (bài nộp, tài liệu vấn đáp, proctor snapshot).
# Bỏ trống thì dùng chung S3_BUCKET với prefix "private/".
S3_BUCKET_PRIVATE=
# R2: "auto". S3 thật: vùng bucket, vd "ap-southeast-1".
S3_REGION=
# R2: https://<account-id>.r2.cloudflarestorage.com — lấy khi tạo R2 API Token.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# CDN domain gắn vào bucket "public" (vd cdn.limio.vn) để trình duyệt tải
# video/ảnh thẳng từ CDN thay vì qua route Next.js. Bỏ trống vẫn chạy được,
# chỉ chậm hơn chút vì mọi request qua app.
S3_PUBLIC_BASE_URL=

# ----- OAuth / API keys -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chỉ đặt trên server nội bộ một trường (vd limio.hust.edu.vn): user đăng nhập SSO
# lần đầu tự thuộc Organization có mã này. Bỏ trống = không tự gắn (mặc định).
# Domains (phẩy phân cách, gồm cả tên miền con) là chốt an toàn: chỉ email thuộc
# các tên miền này được gắn; nên đặt nếu SSO chưa giới hạn tài khoản ngoài trường.
# Người đã có sẵn: chạy `pnpm backfill:sso-org -- --dry-run` một lần.
SSO_DEFAULT_ORG_CODE=
SSO_DEFAULT_ORG_EMAIL_DOMAINS=
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
SENTRY_DSN=

# Google Analytics 4. Đây là NEXT_PUBLIC_* nên được inline LÚC BUILD: đổi giá
# trị phải rebuild image, không chỉ restart container. Property ID + service
# account cho GA4 Data API (Admin Dashboard) cấu hình riêng qua UI
# /admin/integrations (mã hoá trong DB), không qua env.
#
# Server đa domain (limio.vn, HUST...) build riêng — mỗi server set ID CỦA
# DOMAIN MÌNH, còn _ALL đặt CÙNG một giá trị trên MỌI server để có view tổng
# gộp toàn hệ thống:
#   server 224 (limio.vn):            NEXT_PUBLIC_GA_MEASUREMENT_ID=G-KMK5RHZKGD
#   server HUST (limio.hust.edu.vn):  NEXT_PUBLIC_GA_MEASUREMENT_ID=G-4F6QMQGKST
#   cả hai server:                    NEXT_PUBLIC_GA_MEASUREMENT_ID_ALL=G-CET50Y27TY
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-KMK5RHZKGD
NEXT_PUBLIC_GA_MEASUREMENT_ID_ALL=G-CET50Y27TY

# ----- Email (Resend) -----
# Domain limio.vn phải Verified trong Resend. Tạo API key quyền "Sending access".
# Thiếu 1 trong 2 biến → hệ thống chỉ log, không gửi thật.
RESEND_API_KEY=
EMAIL_FROM="Limio <no-reply@limio.vn>"
# Hạn mức gói Resend hiển thị ở admin/emails. Mặc định gói free (100/ngày, 3000/tháng); đặt 0 để ẩn.
EMAIL_DAILY_LIMIT=
EMAIL_MONTHLY_LIMIT=

# ----- Chat LLM tự host (vLLM) -----
# BẮT BUỘC cho mọi tính năng AI chat (vd http://host:8037/vllm/v1). Bỏ trống thì chat báo chưa
# cấu hình, không rơi về OpenAI. Embeddings/Whisper/TTS vẫn là OpenAI nên giữ OpenAI key nếu
# dùng vấn đáp AI/giọng nói. LLM_CHAT_MODEL bỏ trống = qwen3.5-35b-a3b-int4.
LLM_BASE_URL=
LLM_CHAT_MODEL=
LLM_SECKEY=

# ----- Embeddings tự host (Ollama) -----
# Vd http://host:8037/ollama. Qwen3-Embedding, xin 1536 chiều để khớp cột pgvector. Bỏ trống thì vấn đáp
# AI chọn đoạn tài liệu theo từ khoá (vẫn chạy). EMBED_MODEL bỏ trống = qwen3-embedding:8b-ctx16k.
# Sau khi đặt/đổi model: gọi GET /api/cron/reembed-materials (Bearer CRON_SECRET) tới khi remaining=0.
EMBED_BASE_URL=
EMBED_MODEL=
EMBED_SECKEY=

# ----- Lớp chịu tải OpenAI -----
# Số request OpenAI chạy đồng thời MỖI replica web (prod có 3 replica → trần thật = 3 ×).
# Đặt theo RPM của tier OpenAI. Bỏ trống = 20.
OPENAI_MAX_CONCURRENCY=
OPENAI_MAX_RETRIES=
OPENAI_QUEUE_TIMEOUT_MS=

# ----- Lưu trữ -----
# Sổ ghi dung lượng: "off" để tắt khẩn cấp. Bỏ trống = bật.
STORAGE_LEDGER=
# Dọn file mồ côi hằng tuần. Bỏ trống = CHỈ BÁO CÁO (xem log container web). Đọc log vài
# tuần, thấy danh sách đúng rồi mới đặt "apply" — xoá file không hoàn tác được.
STORAGE_ORPHAN_SWEEP=
# Chỉ xét file không đổi quá N ngày (sàn 7, mặc định 30) và xoá tối đa M file mỗi lần (mặc định 500).
STORAGE_ORPHAN_DAYS=
STORAGE_ORPHAN_MAX_DELETE=

