{
  "name": "feedbackme",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @feedbackme/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:generate": "pnpm --filter @feedbackme/db prisma:generate",
    "db:migrate": "pnpm --filter @feedbackme/db prisma:migrate",
    "db:studio": "pnpm --filter @feedbackme/db prisma:studio",
    "db:seed": "pnpm --filter @feedbackme/db seed",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "changelog": "npx --yes git-cliff@latest --output CHANGELOG.md",
    "changelog:preview": "npx --yes git-cliff@latest",
    "backfill:lesson-tags": "pnpm --filter @feedbackme/core-lms backfill:lesson-tags",
    "backfill:feedback-coding": "pnpm --filter @feedbackme/core-feedback backfill:feedback-coding",
    "import:course": "pnpm --filter @feedbackme/core-lms import:course",
    "import:course:prod": "pnpm --filter @feedbackme/core-lms import:course:prod",
    "update:lesson": "pnpm --filter @feedbackme/core-lms update:lesson",
    "update:lesson:prod": "pnpm --filter @feedbackme/core-lms update:lesson:prod",
    "propose:misconceptions": "pnpm --filter @feedbackme/core-feedback propose:misconceptions",
    "apply:misconceptions": "pnpm --filter @feedbackme/core-feedback apply:misconceptions"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
